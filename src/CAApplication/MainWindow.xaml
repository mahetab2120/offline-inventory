<Window x:Class="CAApplication.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CAApplication.ViewModels"
        mc:Ignorable="d"
        Title="AFS Super Admin Portal — Multi-Business Command Center &amp; Provisioning Suite" 
        Height="900" Width="1360"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        FontFamily="{StaticResource ModernFont}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <vm:StringEqualsToBoolConverter x:Key="StringEqualsConverter"/>
    </Window.Resources>

    <Grid>
        <!-- ========================================================================= -->
        <!-- STATE 1: AFS SUPER ADMIN LOGIN SCREEN (When Not Authenticated)            -->
        <!-- ========================================================================= -->
        <Grid Background="{StaticResource BgDarkBrush}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAuthenticated}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Width="500" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource ModernCard}" Padding="44">
                <StackPanel>
                    <!-- Security Badge -->
                    <Border Background="#111827" CornerRadius="20" Padding="14,8" HorizontalAlignment="Center" Margin="0,0,0,24">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛡️ AFS SUPER ADMIN SECURITY GATEWAY" Foreground="{StaticResource AccentCyanBrush}" FontSize="12" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="AFS Master Login" Foreground="{StaticResource TextPrimaryBrush}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="AFS Multi-Business Management &amp; Offline Provisioning Suite" 
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,32"/>

                    <!-- Master Username Input -->
                    <TextBlock Text="Master Username" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding LoginUsername, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="48" FontSize="16" Margin="0,0,0,18" KeyDown="LoginInput_KeyDown"/>

                    <!-- Master Password Input with Show/Hide Toggle -->
                    <TextBlock Text="Master Password" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Masked Password Mode -->
                        <PasswordBox x:Name="MasterPasswordBox"
                                     Grid.Column="0"
                                     Style="{StaticResource ModernPasswordBox}"
                                     Height="48"
                                     FontSize="18"
                                     PasswordChar="●"
                                     PasswordChanged="MasterPasswordBox_PasswordChanged"
                                     KeyDown="LoginInput_KeyDown"
                                     Visibility="{Binding IsPasswordMasked, Converter={StaticResource BoolToVis}}"/>

                        <!-- Plain Text Password Mode (When Show is active) -->
                        <TextBox Grid.Column="0"
                                 Text="{Binding LoginPassword, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"
                                 Height="48"
                                 FontSize="16"
                                 KeyDown="LoginInput_KeyDown"
                                 Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVis}}"/>

                        <!-- Show / Hide Button -->
                        <Button Grid.Column="1"
                                Content="{Binding PasswordToggleIcon}"
                                Style="{StaticResource PrimaryButton}"
                                Background="{StaticResource SurfaceCardBrush}"
                                Foreground="{StaticResource AccentCyanBrush}"
                                Height="48"
                                FontSize="13"
                                FontWeight="Bold"
                                Padding="16,0"
                                Margin="8,0,0,0"
                                Command="{Binding TogglePasswordVisibilityCommand}"/>
                    </Grid>

                    <!-- Error Notice -->
                    <TextBlock Text="{Binding LoginErrorMessage}" Foreground="{StaticResource DangerRedBrush}" FontSize="13" Margin="0,0,0,16" TextWrapping="Wrap" FontWeight="SemiBold"/>

                    <!-- Sign In Button -->
                    <Button Content="🔐 Authenticate &amp; Access AFS Portal" Style="{StaticResource PrimaryButton}" Height="50" FontSize="16" Command="{Binding PerformLoginCommand}" Margin="0,0,0,24" IsDefault="True"/>

                    <Border Background="#0F172A" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <TextBlock Text="DEFAULT CREDENTIALS FOR TESTING:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="Username: superadmin  |  Password: SuperAdmin@2026!" Foreground="{StaticResource AccentCyanBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- STATE 2: AFS SUPER ADMIN WORKSPACE & DASHBOARD (When Authenticated)       -->
        <!-- ========================================================================= -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAuthenticated}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.ColumnDefinitions>
                <!-- Left Navigation Sidebar -->
                <ColumnDefinition Width="280"/>
                <!-- Main Content Area -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Navigation Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceDarkBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="20">
                <DockPanel>
                    <!-- Brand Header -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,28">
                        <TextBlock Text="AFS SUPER ADMIN" Foreground="{StaticResource AccentCyanBrush}" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Text="AFS Command Center" Foreground="{StaticResource TextPrimaryBrush}" FontSize="20" FontWeight="Bold" Margin="0,4,0,4"/>
                        <TextBlock Text="Multi-Business Management Suite" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    </StackPanel>

                    <!-- Footer Status & Logout -->
                    <StackPanel DockPanel.Dock="Bottom">
                        <Border Background="#111827" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="SECURITY KEY STATUS" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="RSA-4096 AFS Key Active" Foreground="{StaticResource SuccessGreenBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                <TextBlock Text="Logged in: superadmin" Foreground="{StaticResource AccentCyanBrush}" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Button Content="🚪 Logout of AFS Portal" Style="{StaticResource DangerButton}" Height="42" FontSize="14" Command="{Binding LogoutCommand}"/>
                    </StackPanel>

                    <!-- Navigation Tabs with Active Indicator -->
                    <StackPanel VerticalAlignment="Top">
                        <RadioButton GroupName="SuperAdminNavTabs" Content="📊 Executive Dashboard" Style="{StaticResource ModernNavRadioButton}" Height="46" HorizontalContentAlignment="Left" IsChecked="{Binding CurrentTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Dashboard, Mode=TwoWay}" Command="{Binding SwitchTabCommand}" CommandParameter="Dashboard"/>
                        <RadioButton GroupName="SuperAdminNavTabs" Content="🏢 Client Business Directory" Style="{StaticResource ModernNavRadioButton}" Height="46" HorizontalContentAlignment="Left" IsChecked="{Binding CurrentTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter=ClientDirectory, Mode=TwoWay}" Command="{Binding SwitchTabCommand}" CommandParameter="ClientDirectory"/>
                        <RadioButton GroupName="SuperAdminNavTabs" Content="➕ Create Client &amp; Issue Key" Style="{StaticResource ModernNavRadioButton}" Height="46" HorizontalContentAlignment="Left" IsChecked="{Binding CurrentTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter=CreateClient, Mode=TwoWay}" Command="{Binding SwitchTabCommand}" CommandParameter="CreateClient"/>
                        <RadioButton GroupName="SuperAdminNavTabs" Content="🔄 License Renewals (.lic)" Style="{StaticResource ModernNavRadioButton}" Height="46" HorizontalContentAlignment="Left" IsChecked="{Binding CurrentTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Renewals, Mode=TwoWay}" Command="{Binding SwitchTabCommand}" CommandParameter="Renewals"/>
                        <RadioButton GroupName="SuperAdminNavTabs" Content="🔓 Decrypt Client Audit (.enc)" Style="{StaticResource ModernNavRadioButton}" Height="46" HorizontalContentAlignment="Left" IsChecked="{Binding CurrentTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter=DecryptAudit, Mode=TwoWay}" Command="{Binding SwitchTabCommand}" CommandParameter="DecryptAudit"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Main Workspace Area -->
            <Grid Grid.Column="1" Margin="24">

                <!-- ================================================================= -->
                <!-- TAB 1: EXECUTIVE DASHBOARD (DEFAULT INITIAL SCREEN)               -->
                <!-- ================================================================= -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="Dashboard">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <StackPanel>
                        <!-- Dashboard Header Bar -->
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="AFS Multi-Business Executive Dashboard" Foreground="{StaticResource TextPrimaryBrush}" FontSize="24" FontWeight="Bold"/>
                                <TextBlock Text="Live client operations, subscription lifecycles, sector breakdown, and encrypted key health" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="➕ Register New Business" Style="{StaticResource SuccessButton}" Height="44" Padding="20,0" FontSize="14" Command="{Binding SwitchTabCommand}" CommandParameter="CreateClient" Margin="0,0,12,0"/>
                                <Button Content="🔄 Refresh Analytics" Style="{StaticResource PrimaryButton}" Background="{StaticResource SurfaceCardBrush}" Height="44" Padding="16,0" FontSize="14" Command="{Binding SwitchTabCommand}" CommandParameter="Dashboard"/>
                            </StackPanel>
                        </Grid>

                        <!-- Top 4 KPI Metrics -->
                        <UniformGrid Columns="4" Margin="0,0,0,24">
                            <!-- Metric 1 -->
                            <Border Style="{StaticResource ModernCard}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="TOTAL BUSINESSES" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding TotalClients}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="32" FontWeight="Bold" Margin="0,4,0,0"/>
                                    <TextBlock Text="Across all retail sectors" Foreground="{StaticResource AccentCyanBrush}" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Metric 2 -->
                            <Border Style="{StaticResource ModernCard}" Margin="4,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="ACTIVE LICENSES" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding ActiveLicenses}" Foreground="{StaticResource SuccessGreenBrush}" FontSize="32" FontWeight="Bold" Margin="0,4,0,0"/>
                                    <TextBlock Text="100% Compliant &amp; Running" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Metric 3 -->
                            <Border Style="{StaticResource ModernCard}" Margin="4,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="EXPIRING SOON (&lt; 7 DAYS)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding ExpiringSoonCount}" Foreground="{StaticResource WarningAmberBrush}" FontSize="32" FontWeight="Bold" Margin="0,4,0,0"/>
                                    <TextBlock Text="Requires renewal key (.lic)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Metric 4 -->
                            <Border Style="{StaticResource ModernCard}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="ESTIMATED RUN-RATE" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding MonthlyEstimatedRevenue}" Foreground="{StaticResource AccentCyanBrush}" FontSize="32" FontWeight="Bold" Margin="0,4,0,0"/>
                                    <TextBlock Text="Active monthly subscriptions" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Analytics Row: Sector Breakdown & Growth Trend Charts -->
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Chart 1: Business Classification Distribution -->
                            <Border Grid.Column="0" Style="{StaticResource ModernCard}">
                                <StackPanel>
                                    <TextBlock Text="🏢 Business Classification Distribution" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBlock Text="Breakdown of client stores across commercial retail sectors" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,16"/>

                                    <ItemsControl ItemsSource="{Binding SectorDistributions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="60"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding SectorName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                                    <!-- Progress Bar -->
                                                    <Border Grid.Column="1" Background="#0F172A" CornerRadius="4" Height="14" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <Border Background="{Binding BarColor}" HorizontalAlignment="Left" Width="{Binding Percentage, ConverterParameter=2.2}" CornerRadius="4"/>
                                                    </Border>

                                                    <TextBlock Grid.Column="2" Text="{Binding FormattedPercentage}" Foreground="{StaticResource AccentCyanBrush}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Chart 2: Monthly Business Onboarding Trend (Bar Columns) -->
                            <Border Grid.Column="2" Style="{StaticResource ModernCard}">
                                <StackPanel>
                                    <TextBlock Text="📈 Monthly Business Onboarding Trend" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBlock Text="Active provisioned client accounts by month" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,16"/>

                                    <!-- Bar Chart Visual Columns -->
                                    <ItemsControl ItemsSource="{Binding MonthlyGrowthTrends}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="6" Height="140" VerticalAlignment="Bottom"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding ValueLabel}" Foreground="{StaticResource AccentCyanBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                    <Border Background="{StaticResource PrimaryBlueBrush}" Width="36" Height="{Binding BarHeight}" CornerRadius="4,4,0,0"/>
                                                    <TextBlock Text="{Binding MonthName}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Client Businesses Live Monitor Table -->
                        <Border Style="{StaticResource ModernCard}">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="260"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="🏢 Managed Client Businesses" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold"/>
                                        <TextBlock Text="Live client store records, license validity countdown, and provisioning status" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Status Filter Quick Buttons -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <Button Content="All" Style="{StaticResource PrimaryButton}" Height="36" Padding="12,0" FontSize="12" Margin="0,0,6,0" Command="{Binding SetStatusFilterCommand}" CommandParameter="All"/>
                                        <Button Content="🟢 Active" Style="{StaticResource PrimaryButton}" Background="{StaticResource SurfaceCardBrush}" Height="36" Padding="12,0" FontSize="12" Margin="0,0,6,0" Command="{Binding SetStatusFilterCommand}" CommandParameter="Active"/>
                                        <Button Content="🟡 Expiring Soon" Style="{StaticResource PrimaryButton}" Background="{StaticResource SurfaceCardBrush}" Height="36" Padding="12,0" FontSize="12" Margin="0,0,6,0" Command="{Binding SetStatusFilterCommand}" CommandParameter="ExpiringSoon"/>
                                        <Button Content="⚪ Suspended" Style="{StaticResource PrimaryButton}" Background="{StaticResource SurfaceCardBrush}" Height="36" Padding="12,0" FontSize="12" Command="{Binding SetStatusFilterCommand}" CommandParameter="Suspended"/>
                                    </StackPanel>

                                    <!-- Search Input -->
                                    <TextBox Grid.Column="2" 
                                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{StaticResource ModernTextBox}" 
                                             Height="38" 
                                             FontSize="13"
                                             Padding="12,4"/>
                                </Grid>

                                <!-- Table Header -->
                                <Border Background="#111827" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="BUSINESS CODE" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="1" Text="LEGAL &amp; TRADE NAME" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="2" Text="CLASSIFICATION" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="3" Text="SUBSCRIPTION" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="4" Text="EXPIRY DATE" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="5" Text="DAYS LEFT" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="6" Text="STATUS" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="7" Text="QUICK ACTIONS" Foreground="{StaticResource AccentCyanBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>

                                <!-- Table Rows -->
                                <ItemsControl ItemsSource="{Binding FilteredClients}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1E293B" CornerRadius="6" Padding="14,10" Margin="0,0,0,6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130"/>
                                                        <ColumnDefinition Width="200"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding BusinessCode}" Foreground="{StaticResource AccentCyanBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TradeName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding LegalName}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                    </StackPanel>

                                                    <Border Grid.Column="2" Background="#0F172A" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding BusinessTypeBadge}" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                                                    </Border>

                                                    <Border Grid.Column="3" Background="#1E1B4B" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding PlanBadge}" Foreground="#A5B4FC" FontSize="11" FontWeight="Bold"/>
                                                    </Border>

                                                    <TextBlock Grid.Column="4" Text="{Binding ExpiryDateUtc, StringFormat='{}{0:dd-MMM-yyyy}'}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Column="5" Text="{Binding DaysRemaining, StringFormat='{}{0} Days'}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                                    <Border Grid.Column="6" Background="{Binding StatusColor}" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Status}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                    </Border>

                                                    <!-- Quick Action Icon Toolbar -->
                                                    <StackPanel Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Button Content="📧 Email" Style="{StaticResource PrimaryButton}" Padding="8,4" FontSize="11" Margin="0,0,4,0" ToolTip="Draft &amp; Send Activation Email with .key Attachment" Command="{Binding DataContext.ResendClientEmailCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                        <Button Content="🔄 Plan" Style="{StaticResource SuccessButton}" Padding="8,4" FontSize="11" Margin="0,0,4,0" ToolTip="Update Subscription Plan &amp; Renew License" Command="{Binding DataContext.OpenSubscriptionModalCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                        <Button Content="📜 .lic" Style="{StaticResource SuccessButton}" Background="#065F46" Padding="8,4" FontSize="11" Margin="0,0,4,0" ToolTip="Issue Signed Offline Renewal Certificate (.lic)" Command="{Binding DataContext.SelectClientForRenewalCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                        <Button Content="🔑 Key" Style="{StaticResource PrimaryButton}" Background="{StaticResource SurfaceCardBrush}" Padding="8,4" FontSize="11" Margin="0,0,4,0" ToolTip="Re-export Encrypted Key &amp; Open Explorer" Command="{Binding DataContext.ReExportClientKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                        <Button Content="📋" Style="{StaticResource PrimaryButton}" Background="{StaticResource SurfaceCardBrush}" Padding="8,4" FontSize="11" ToolTip="Copy Store Account Credentials" Command="{Binding DataContext.CopyClientCredentialsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ================================================================= -->
                <!-- TAB 2: REGISTER CLIENT & ISSUE ENCRYPTED DATA KEY                 -->
                <!-- ================================================================= -->
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource ModernCard}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="CreateClient">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Register Client Business &amp; Issue Encrypted Data Key" Foreground="{StaticResource TextPrimaryBrush}" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text="Configure business profile, store contact details for automated email drafting, and administrator credentials. The generated .key file and setup email will be prepared automatically." Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,4,0,20"/>

                            <!-- Error Validation Alert Banner -->
                            <Border Background="#7F1D1D" BorderBrush="#EF4444" BorderThickness="1.5" CornerRadius="8" Padding="14" Margin="0,0,0,16" Visibility="{Binding IsValidationError, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚠️ " FontSize="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding FormValidationErrorMessage}" Foreground="#FEE2E2" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Success Notification Banner -->
                            <Border Background="{StaticResource PrimaryBlueBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,20" Visibility="{Binding IsKeyGenerated, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="✅ Encrypted Data Key &amp; Client Email Draft Generated Successfully!" Foreground="White" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding StatusMessage}" Foreground="#E0E7FF" FontSize="12" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- 3-Column Input Form -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <!-- Column 1: Business Profile -->
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="18"/>
                                    <!-- Column 2: Contact Details & Address -->
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="18"/>
                                    <!-- Column 3: Credentials & Subscription -->
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Column 1: Business Profile -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="1. BUSINESS PROFILE" Foreground="{StaticResource AccentCyanBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,0,12"/>

                                    <TextBlock Text="Unique Business Code (System Generated)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,12">
                                        <TextBox Text="{Binding BusinessCode}" Style="{StaticResource ModernTextBox}" Height="44" IsReadOnly="True" Focusable="False" Background="#0B0F17" Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" Padding="14,4" Cursor="No" ToolTip="Immutable System Generated Business Code"/>
                                        <Border Background="#1E293B" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False">
                                            <TextBlock Text="🔒 Locked" Foreground="#94A3B8" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="Legal Company Name *" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding LegalName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="44" Margin="0,0,0,12" ToolTip="Full registered company or business name"/>

                                    <TextBlock Text="Trade / Store Name (Optional)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding TradeName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="44" Margin="0,0,0,12" ToolTip="Display name on bills and invoices"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="GSTIN (15 Chars) *" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding Gstin, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="44" ToolTip="Format: 2 state digits + 10-char PAN + 1 entity + Z + 1 checksum (e.g. 27ASDFP4402C1Z5)"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="PAN (10 Chars) *" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding Pan, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="44" ToolTip="Format: 5 letters, 4 digits, 1 letter (e.g. ASDFP4402C)"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Business Classification" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding BusinessTypes}" SelectedItem="{Binding SelectedBusinessType}" Style="{StaticResource ModernComboBox}" Height="44"/>
                                </StackPanel>

                                <!-- Column 2: Contact Details & Store Address -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="2. CONTACT &amp; DELIVERY" Foreground="{StaticResource AccentCyanBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,0,12"/>

                                    <TextBlock Text="Owner / Contact Person Name" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding ContactPerson, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="44" Margin="0,0,0,12" ToolTip="Client Contact Person Name"/>

                                    <TextBlock Text="Client Email Address (Key Delivery) *" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding ContactEmail, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="44" Margin="0,0,0,12" ToolTip="Email where .key file and credentials will be sent"/>

                                    <TextBlock Text="Mobile / WhatsApp Number *" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding ContactPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="44" Margin="0,0,0,12"/>

                                    <TextBlock Text="Store Street Address" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="44" Margin="0,0,0,12"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="City" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="44"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="State" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding State, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="44"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Pincode" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding Pincode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="44"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- Column 3: Credentials & Subscription -->
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="3. CREDENTIALS &amp; PLAN" Foreground="{StaticResource AccentCyanBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,0,12"/>

                                    <TextBlock Text="Business Admin Username" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding AdminUsername, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="44" Margin="0,0,0,12"/>

                                    <TextBlock Text="Temporary Initial Password" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding AdminTempPassword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="44" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Subscription Tier" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding SubscriptionTiers}" SelectedItem="{Binding SelectedPlan}" Style="{StaticResource ModernComboBox}" Height="44"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Duration (Months)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding ValidityMonths, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="44"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Action Buttons -->
                                    <StackPanel Margin="0,20,0,0">
                                        <Button Content="🔐 Generate Key &amp; Draft Client Email" Style="{StaticResource SuccessButton}" Height="48" FontSize="14" FontWeight="Bold" Command="{Binding GenerateAndExportDataKeyCommand}" Margin="0,0,0,10"/>
                                        <Button Content="🔄 Reset Form" Style="{StaticResource PrimaryButton}" Background="{StaticResource SurfaceCardBrush}" Height="42" FontSize="13" Command="{Binding ResetFormCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!-- ========================================================================= -->
                            <!-- EMAIL DRAFT & CLIENT ONBOARDING PACKAGE CARD (WHEN GENERATED)            -->
                            <!-- ========================================================================= -->
                            <Border Background="#111827" BorderBrush="{StaticResource AccentCyanBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,24,0,0" Visibility="{Binding IsKeyGenerated, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <!-- Header -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="📨 CLIENT ACTIVATION EMAIL DRAFT READY" Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" FontSize="15"/>
                                            <TextBlock Text="This email contains store credentials and step-by-step instructions. Send it to the client with the attached .key file." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Attachment Badge -->
                                        <Border Grid.Column="1" Background="#1E293B" CornerRadius="6" Padding="12,6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📎 Attached: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                                <TextBlock Text="{Binding GeneratedKeyFileName}" Foreground="{StaticResource SuccessGreenBrush}" FontSize="12" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Recipient and Subject Row -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Recipient:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding EmailRecipient, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="38" FontSize="13"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Subject:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding EmailSubject, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="38" FontSize="13"/>
                                    </Grid>

                                    <!-- Action Toolbar -->
                                    <WrapPanel Margin="0,0,0,14">
                                        <Button Content="📧 Open in Mail Client (Draft)" Style="{StaticResource PrimaryButton}" Height="40" FontSize="13" Padding="16,0" Command="{Binding OpenMailClientCommand}" Margin="0,0,10,6"/>
                                        <Button Content="🌐 Open in Gmail Web" Style="{StaticResource PrimaryButton}" Background="#B91C1C" Height="40" FontSize="13" Padding="16,0" Command="{Binding OpenWebmailGmailCommand}" Margin="0,0,10,6"/>
                                        <Button Content="📋 Copy Complete Email Text" Style="{StaticResource PrimaryButton}" Background="{StaticResource SurfaceCardBrush}" Foreground="{StaticResource AccentCyanBrush}" Height="40" FontSize="13" Padding="16,0" Command="{Binding CopyEmailDraftCommand}" Margin="0,0,10,6"/>
                                        <Button Content="📁 Show Key in Explorer" Style="{StaticResource PrimaryButton}" Background="{StaticResource SurfaceCardBrush}" Height="40" FontSize="13" Padding="16,0" Command="{Binding OpenGeneratedKeysFolderCommand}" Margin="0,0,0,6"/>
                                    </WrapPanel>

                                    <!-- Status Message Notification -->
                                    <TextBlock Text="{Binding EmailStatusNotification}" Foreground="{StaticResource SuccessGreenBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10" TextWrapping="Wrap"/>

                                    <!-- Email Body Text Box Preview -->
                                    <Border Background="#0B0F17" CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12">
                                        <TextBox Text="{Binding EmailBody, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="#E2E8F0" BorderThickness="0" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" TextWrapping="Wrap" Height="260" VerticalScrollBarVisibility="Auto"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Generated Key Hand-off Summary -->
                            <Border Background="#111827" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,16,0,0" Visibility="{Binding IsKeyGenerated, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="CLIENT TECHNICAL HANDOFF SUMMARY" Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" FontSize="12"/>
                                    <TextBox Text="{Binding ExportedKeySummary}" IsReadOnly="True" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}" BorderThickness="0" FontFamily="Consolas" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- ================================================================= -->
                <!-- TAB 3: CLIENT DIRECTORY                                           -->
                <!-- ================================================================= -->
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource ModernCard}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="ClientDirectory">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="280"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Client Business Directory &amp; Records" Foreground="{StaticResource TextPrimaryBrush}" FontSize="22" FontWeight="Bold"/>
                                    <TextBlock Text="Full repository of registered offline business establishments" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Status Filter Quick Buttons -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <Button Content="All" Style="{StaticResource PrimaryButton}" Height="38" Padding="14,0" FontSize="12" Margin="0,0,6,0" Command="{Binding SetStatusFilterCommand}" CommandParameter="All"/>
                                    <Button Content="🟢 Active" Style="{StaticResource PrimaryButton}" Background="{StaticResource SurfaceCardBrush}" Height="38" Padding="14,0" FontSize="12" Margin="0,0,6,0" Command="{Binding SetStatusFilterCommand}" CommandParameter="Active"/>
                                    <Button Content="🟡 Expiring Soon" Style="{StaticResource PrimaryButton}" Background="{StaticResource SurfaceCardBrush}" Height="38" Padding="14,0" FontSize="12" Margin="0,0,6,0" Command="{Binding SetStatusFilterCommand}" CommandParameter="ExpiringSoon"/>
                                    <Button Content="⚪ Suspended" Style="{StaticResource PrimaryButton}" Background="{StaticResource SurfaceCardBrush}" Height="38" Padding="14,0" FontSize="12" Command="{Binding SetStatusFilterCommand}" CommandParameter="Suspended"/>
                                </StackPanel>

                                <TextBox Grid.Column="2" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="38" FontSize="13" Padding="12,4"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding FilteredClients}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1E293B" CornerRadius="8" Padding="20" Margin="0,0,0,14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <!-- Top: Title, Badges & Status -->
                                                    <RowDefinition Height="Auto"/>
                                                    <!-- Middle: Contact & Address Details -->
                                                    <RowDefinition Height="Auto"/>
                                                    <!-- Bottom: Action Toolbar & Expiry -->
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Row 1: Header & Status -->
                                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding TradeName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="17" FontWeight="Bold"/>
                                                            <Border Background="#0F172A" CornerRadius="4" Padding="8,3" Margin="10,0,0,0">
                                                                <TextBlock Text="{Binding BusinessCode}" Foreground="{StaticResource AccentCyanBrush}" FontSize="12" FontWeight="Bold"/>
                                                            </Border>
                                                            <Border Background="#1E1B4B" CornerRadius="4" Padding="8,3" Margin="8,0,0,0">
                                                                <TextBlock Text="{Binding PlanBadge}" Foreground="#A5B4FC" FontSize="11" FontWeight="Bold"/>
                                                            </Border>
                                                            <Border Background="#064E3B" CornerRadius="4" Padding="8,3" Margin="8,0,0,0">
                                                                <TextBlock Text="{Binding BusinessTypeBadge}" Foreground="#6EE7B7" FontSize="11" FontWeight="SemiBold"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding LegalName}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,4,0,0"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right">
                                                        <Border Background="{Binding StatusColor}" CornerRadius="4" Padding="10,5" HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding Status}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Row 2: Contact, GSTIN, PAN & Store Location -->
                                                <Border Grid.Row="1" Background="#111827" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Col 1: Contact Delivery -->
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="CONTACT PERSON &amp; EMAIL" Foreground="{StaticResource AccentCyanBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                                            <TextBlock Text="{Binding ContactPerson}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding ContactEmail}" Foreground="#94A3B8" FontSize="12"/>
                                                            <TextBlock Text="{Binding ContactPhone, StringFormat='📱 {0}'}" Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0"/>
                                                        </StackPanel>

                                                        <!-- Col 2: Statutory Tax IDs -->
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="STATUTORY TAX REGISTRATION" Foreground="{StaticResource AccentCyanBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="GSTIN: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                                                <TextBlock Text="{Binding GSTIN}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="Bold"/>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <TextBlock Text="PAN: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                                                <TextBlock Text="{Binding PAN}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="Bold"/>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <TextBlock Text="Admin User: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                                                <TextBlock Text="{Binding AdminUsername}" Foreground="{StaticResource AccentCyanBrush}" FontSize="12" FontWeight="SemiBold"/>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- Col 3: Address & Expiry -->
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="STORE LOCATION &amp; VALIDITY" Foreground="{StaticResource AccentCyanBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                                            <TextBlock Text="{Binding Address}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                                                            <TextBlock Text="{Binding City, StringFormat='{}{0}, '}" Foreground="#94A3B8" FontSize="12"/>
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <TextBlock Text="Expires: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                                                <TextBlock Text="{Binding ExpiryDateUtc, StringFormat='{}{0:dd-MMM-yyyy}'}" Foreground="{StaticResource SuccessGreenBrush}" FontSize="12" FontWeight="Bold"/>
                                                                <TextBlock Text="{Binding DaysRemaining, StringFormat=' ({0} Days)'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- Row 3: Quick Action Buttons -->
                                                <Grid Grid.Row="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="🔑 Key Package: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                                        <TextBlock Text="{Binding BusinessCode, StringFormat='Client_{0}_DataKey.key'}" Foreground="{StaticResource AccentCyanBrush}" FontSize="12" FontWeight="SemiBold"/>
                                                    </StackPanel>

                                                    <!-- Action Button Bar -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button Content="📧 Email" Style="{StaticResource PrimaryButton}" Height="36" FontSize="12" Padding="12,0" Margin="0,0,6,0" ToolTip="Prepare Activation Email with .key Attachment &amp; Open Mail Client" Command="{Binding DataContext.ResendClientEmailCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                        <Button Content="🔄 Plan" Style="{StaticResource SuccessButton}" Height="36" FontSize="12" Padding="12,0" Margin="0,0,6,0" ToolTip="Select Plan Tier, Validity Period &amp; Update Database" Command="{Binding DataContext.OpenSubscriptionModalCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                        <Button Content="📜 Issue .lic" Style="{StaticResource SuccessButton}" Background="#065F46" Height="36" FontSize="12" Padding="12,0" Margin="0,0,6,0" ToolTip="Issue Signed Offline Renewal Certificate (.lic) for this client" Command="{Binding DataContext.SelectClientForRenewalCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                        <Button Content="🔑 Key" Style="{StaticResource PrimaryButton}" Background="{StaticResource SurfaceCardBrush}" Height="36" FontSize="12" Padding="10,0" Margin="0,0,6,0" ToolTip="Re-export Signed .key File and Reveal in Windows Explorer" Command="{Binding DataContext.ReExportClientKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                        <Button Content="📋 Copy" Style="{StaticResource PrimaryButton}" Background="{StaticResource SurfaceCardBrush}" Height="36" FontSize="12" Padding="10,0" Margin="0,0,6,0" ToolTip="Copy Store Account Credentials to Clipboard" Command="{Binding DataContext.CopyClientCredentialsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                        <Button Content="🚫 Suspend" Style="{StaticResource PrimaryButton}" Background="#334155" Height="36" FontSize="12" Padding="10,0" ToolTip="Toggle Account Active / Suspended Status" Command="{Binding DataContext.ToggleClientStatusCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- ================================================================= -->
                <!-- TAB 4: LICENSE RENEWALS & EXTENSIONS (.lic)                       -->
                <!-- ================================================================= -->
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource ModernCard}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="Renewals">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Header Bar -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🔄 Client Business License Extensions &amp; Renewals (.lic)" Foreground="{StaticResource TextPrimaryBrush}" FontSize="22" FontWeight="Bold"/>
                                        <Border Background="#1E1B4B" CornerRadius="4" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="RSA-4096 SHA256 SIGNED" Foreground="#A5B4FC" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Generate cryptographically signed offline renewal certificates (.lic) to extend client business subscriptions with zero internet required." Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="📁 Open Licenses Folder" Style="{StaticResource PrimaryButton}" Background="{StaticResource SurfaceCardBrush}" Height="40" Padding="14,0" FontSize="13" Command="{Binding OpenLicenseFolderCommand}"/>
                            </Grid>

                            <!-- Renewal Status Notification -->
                            <Border Background="{StaticResource PrimaryBlueBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,20" Visibility="{Binding IsLicenseRenewalGenerated, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✅ " FontSize="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding RenewalStatusMessage}" Foreground="White" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Top Section: 2 Columns (Configuration + Issued Manifest) -->
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="0.9*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Column: Client Selection & Extension Config -->
                                <Border Grid.Column="0" Background="#111827" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20">
                                    <StackPanel>
