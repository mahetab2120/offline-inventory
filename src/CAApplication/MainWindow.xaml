                                                    <TextBlock Text="{Binding SelectedRenewalClient.ContactEmail, StringFormat='✉️ {0}'}" Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                    <TextBlock Text="CURRENT STATUS" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                    <Border Background="{Binding SelectedRenewalClient.StatusColor}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Right" Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding SelectedRenewalClient.Status}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding SelectedRenewalClient.ExpiryDateUtc, StringFormat='Expires: {0:dd-MMM-yyyy}'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                                    <TextBlock Text="{Binding SelectedRenewalClient.DaysRemaining, StringFormat='{}{0} Days Remaining'}" Foreground="{StaticResource AccentCyanBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <TextBlock Text="2. CONFIGURE SUBSCRIPTION EXTENSION" Foreground="{StaticResource AccentCyanBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,0,12"/>

                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Subscription Plan Tier" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding SubscriptionTiers}" SelectedItem="{Binding RenewalSelectedPlan}" Style="{StaticResource ModernComboBox}" Height="44"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Validity Extension Duration" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding ValidityOptions}" SelectedItem="{Binding RenewalSelectedValidity}" DisplayMemberPath="DisplayText" Style="{StaticResource ModernComboBox}" Height="44"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Calculated New Expiry Badge -->
                                        <Border Background="#064E3B" CornerRadius="8" Padding="16" Margin="0,0,0,18" BorderBrush="{StaticResource SuccessGreenBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="CALCULATED NEW EXPIRATION DATE" Foreground="#A7F3D0" FontSize="11" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding RenewalCalculatedExpiryDate, StringFormat='{}{0:dddd, dd MMMM yyyy}'}" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,4,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="#047857" CornerRadius="4" Padding="10,6" VerticalAlignment="Center">
                                                    <TextBlock Text="RSA-4096 SIGNED" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Action Button -->
                                        <Button Content="🔄 Generate &amp; Sign License Certificate (.lic)" 
                                                Style="{StaticResource SuccessButton}" 
                                                Height="48" 
                                                FontSize="14" 
                                                FontWeight="Bold" 
                                                Command="{Binding GenerateLicenseRenewalPackageCommand}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Right Column: Issued Certificate Manifest & Handoff -->
                                <Border Grid.Column="2" Background="#111827" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20">
                                    <StackPanel>
                                        <TextBlock Text="CERTIFICATE TECHNICAL MANIFEST (.lic)" Foreground="{StaticResource AccentCyanBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,0,12"/>

                                        <Border Background="#1E293B" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="#334155" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="Active Certificate File:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock Text="{Binding LastExportedLicenseFileName, TargetNullValue='No license generated yet.'}" Foreground="{StaticResource SuccessGreenBrush}" FontSize="13" FontWeight="Bold" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding LastExportedLicensePath, TargetNullValue=''}" Foreground="#64748B" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Action buttons for Manifest -->
                                        <WrapPanel Margin="0,0,0,12">
                                            <Button Content="📋 Copy License Summary" Style="{StaticResource PrimaryButton}" Background="{StaticResource SurfaceCardBrush}" Foreground="{StaticResource AccentCyanBrush}" Height="36" FontSize="12" Padding="12,0" Command="{Binding CopyLicenseSummaryCommand}" Margin="0,0,8,6"/>
                                            <Button Content="📁 Reveal in Explorer" Style="{StaticResource PrimaryButton}" Height="36" FontSize="12" Padding="12,0" Command="{Binding OpenLicenseFolderCommand}" Margin="0,0,0,6"/>
                                        </WrapPanel>

                                        <!-- Certificate Content Preview -->
                                        <Border Background="#0B0F17" CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,14">
                                            <TextBox Text="{Binding RenewalSummaryText, TargetNullValue='Select a client business and click Generate &amp; Sign License Certificate to produce a cryptographic license.'}" 
                                                     IsReadOnly="True" 
                                                     Background="Transparent" 
                                                     Foreground="#E2E8F0" 
                                                     BorderThickness="0" 
                                                     FontFamily="Consolas" 
                                                     FontSize="11" 
                                                     AcceptsReturn="True" 
                                                     TextWrapping="Wrap" 
                                                     Height="180" 
                                                     VerticalScrollBarVisibility="Auto"/>
                                        </Border>

                                        <!-- Offline Handoff Info Box -->
                                        <Border Background="#0F172A" CornerRadius="6" Padding="12" BorderBrush="#334155" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="ℹ️ CLIENT OFFLINE ACTIVATION GUIDE" Foreground="{StaticResource AccentCyanBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                                <TextBlock Text="1. Transfer the generated .lic file to the client via USB, local LAN, or email.&#x0a;2. In the AFS Desktop Business App, click 'Renew License Certificate'.&#x0a;3. Select this .lic file for instant validation without internet." Foreground="#94A3B8" FontSize="11" LineHeight="16" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Bottom Section: Quick Renewal Directory Table -->
                            <Border Background="#111827" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="300"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="⚡ Quick Client Renewal Directory" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold"/>
                                            <TextBlock Text="Direct one-click renewal selection for all registered offline client businesses" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="38" FontSize="13" Padding="10,4"/>
                                    </Grid>

                                    <!-- Table Header -->
                                    <Border Background="#1E293B" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="BUSINESS CODE" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="1" Text="TRADE &amp; LEGAL NAME" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="2" Text="CURRENT PLAN" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="3" Text="EXPIRY DATE" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="4" Text="DAYS LEFT" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="5" Text="STATUS" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="6" Text="ACTION" Foreground="{StaticResource AccentCyanBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>

                                    <!-- Table Rows -->
                                    <ItemsControl ItemsSource="{Binding FilteredClients}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#1E293B" CornerRadius="6" Padding="14,10" Margin="0,0,0,6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="130"/>
                                                            <ColumnDefinition Width="220"/>
                                                            <ColumnDefinition Width="130"/>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Text="{Binding BusinessCode}" Foreground="{StaticResource AccentCyanBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding TradeName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding LegalName}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                        </StackPanel>

                                                        <Border Grid.Column="2" Background="#1E1B4B" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding PlanBadge}" Foreground="#A5B4FC" FontSize="11" FontWeight="Bold"/>
                                                        </Border>

                                                        <TextBlock Grid.Column="3" Text="{Binding ExpiryDateUtc, StringFormat='{}{0:dd-MMM-yyyy}'}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center"/>

                                                        <TextBlock Grid.Column="4" Text="{Binding DaysRemaining, StringFormat='{}{0} Days'}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                                        <Border Grid.Column="5" Background="{Binding StatusColor}" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Status}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                        </Border>

                                                        <Button Grid.Column="6" 
                                                                Content="⚡ Select &amp; Renew" 
                                                                Style="{StaticResource SuccessButton}" 
                                                                Padding="12,4" 
                                                                FontSize="11" 
                                                                HorizontalAlignment="Right" 
                                                                VerticalAlignment="Center"
                                                                Command="{Binding DataContext.SelectClientForRenewalCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- ================================================================= -->
                <!-- TAB 5: DECRYPT CLIENT COMMERCIAL AUDIT (.afspkg / .enc)           -->
                <!-- ================================================================= -->
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource ModernCard}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="DecryptAudit">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Header Bar -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🔓 Decrypt Client Commercial Audit Packages (.afspkg / .enc)" Foreground="{StaticResource TextPrimaryBrush}" FontSize="22" FontWeight="Bold"/>
                                        <Border Background="#064E3B" CornerRadius="4" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="AES-256-GCM AUTHENTICATED" Foreground="#6EE7B7" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Cryptographically verify and decrypt client store commercial records, GST invoices ledger, HSN breakdowns, and audit trails." Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="📥 Export CSV" Style="{StaticResource PrimaryButton}" Background="{StaticResource SurfaceCardBrush}" Height="40" Padding="14,0" FontSize="13" Command="{Binding ExportDecryptedAuditCsvCommand}" Margin="0,0,8,0" Visibility="{Binding IsAuditPackageDecrypted, Converter={StaticResource BoolToVis}}"/>
                                    <Button Content="📁 Open Folder" Style="{StaticResource PrimaryButton}" Background="{StaticResource SurfaceCardBrush}" Height="40" Padding="14,0" FontSize="13" Command="{Binding OpenAuditFolderCommand}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Package Selection & Decrypt Trigger Card -->
                            <Border Background="#111827" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="SELECT ENCRYPTED AUDIT PACKAGE FILE" Foreground="{StaticResource AccentCyanBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0" 
                                                 Text="{Binding SelectedAuditFilePath, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource ModernTextBox}" 
                                                 Height="44" 
                                                 FontSize="13" 
                                                 Padding="12,4"/>

                                        <Button Grid.Column="2" 
                                                Content="📂 Browse Package..." 
                                                Style="{StaticResource PrimaryButton}" 
                                                Height="44" 
                                                Padding="16,0" 
                                                FontSize="13" 
                                                Command="{Binding BrowseAuditPackageFileCommand}"/>

                                        <Button Grid.Column="4" 
                                                Content="🔓 Decrypt &amp; Inspect Package" 
                                                Style="{StaticResource SuccessButton}" 
                                                Height="44" 
                                                Padding="20,0" 
                                                FontSize="14" 
                                                FontWeight="Bold" 
                                                Command="{Binding ExecuteDecryptAuditPackageCommand}"/>

                                        <Button Grid.Column="6" 
                                                Content="🧹 Clear" 
                                                Style="{StaticResource PrimaryButton}" 
                                                Background="#334155" 
                                                Height="44" 
                                                Padding="14,0" 
                                                FontSize="13" 
                                                Command="{Binding ClearDecryptedAuditCommand}"/>
                                    </Grid>

                                    <!-- Status notification banner -->
                                    <Border Background="#1E293B" CornerRadius="6" Padding="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <TextBlock Text="{Binding DecryptStatusMessage, TargetNullValue='Please select an exported .afspkg or .enc package file from the client store and click Decrypt.'}" 
                                                   Foreground="{StaticResource AccentCyanBrush}" 
                                                   FontSize="12" 
                                                   FontWeight="SemiBold" 
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Decrypted Commercial Overview (Visible when IsAuditPackageDecrypted is True) -->
                            <StackPanel Visibility="{Binding IsAuditPackageDecrypted, Converter={StaticResource BoolToVis}}">
                                <!-- KPI Cards (4 metrics) -->
                                <UniformGrid Columns="4" Margin="0,0,0,20">
                                    <Border Style="{StaticResource ModernCard}" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="CLIENT BUSINESS ENTITY" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding AuditLegalName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding AuditGstin, StringFormat='GSTIN: {0}'}" Foreground="{StaticResource AccentCyanBrush}" FontSize="12" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding AuditBusinessCode, StringFormat='Code: {0}'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource ModernCard}" Margin="3,0,3,0">
                                        <StackPanel>
                                            <TextBlock Text="ACCOUNTING PERIOD" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding AuditAccountingPeriod}" Foreground="{StaticResource AccentCyanBrush}" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding AuditExportTimestamp, StringFormat='Exported: {0:dd-MMM-yyyy HH:mm} UTC'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding AuditTotalInvoices, StringFormat='{}{0} Invoices Decrypted'}" Foreground="{StaticResource SuccessGreenBrush}" FontSize="11" FontWeight="Bold" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource ModernCard}" Margin="3,0,3,0">
                                        <StackPanel>
                                            <TextBlock Text="TAXABLE TURNOVER &amp; GST" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding AuditTaxableTurnover, StringFormat='₹{0:N2}'}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding AuditTotalTax, StringFormat='Total Tax: ₹{0:N2}'}" Foreground="{StaticResource WarningAmberBrush}" FontSize="12" FontWeight="Bold" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding AuditTotalCgst, StringFormat='CGST ₹{0:N2} | SGST ₹{0:N2}'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource ModernCard}" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="GROSS REVENUE &amp; VALUATION" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding AuditTotalRevenue, StringFormat='₹{0:N2}'}" Foreground="{StaticResource SuccessGreenBrush}" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding AuditInventoryValuation, StringFormat='Inventory: ₹{0:N2}'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding AuditLogsCount, StringFormat='Audit Trail: {0} Logs'}" Foreground="{StaticResource AccentCyanBrush}" FontSize="11" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- Decrypted Sub-Tab Navigation Bar -->
                                <Border Background="#111827" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,0,16">
