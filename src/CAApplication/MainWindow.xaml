                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="📑 Invoices Ledger" Style="{StaticResource PrimaryButton}" Background="{StaticResource PrimaryBlueBrush}" Height="36" Padding="14,0" FontSize="12" Command="{Binding SwitchAuditSubTabCommand}" CommandParameter="Invoices" Margin="0,0,6,0"/>
                                            <Button Content="📊 GST Tax &amp; HSN Summary" Style="{StaticResource PrimaryButton}" Background="{StaticResource SurfaceCardBrush}" Height="36" Padding="14,0" FontSize="12" Command="{Binding SwitchAuditSubTabCommand}" CommandParameter="TaxSummary" Margin="0,0,6,0"/>
                                            <Button Content="📦 Inventory Catalog Valuation" Style="{StaticResource PrimaryButton}" Background="{StaticResource SurfaceCardBrush}" Height="36" Padding="14,0" FontSize="12" Command="{Binding SwitchAuditSubTabCommand}" CommandParameter="Inventory" Margin="0,0,6,0"/>
                                            <Button Content="🛡️ Tamper-Proof Audit Trail" Style="{StaticResource PrimaryButton}" Background="{StaticResource SurfaceCardBrush}" Height="36" Padding="14,0" FontSize="12" Command="{Binding SwitchAuditSubTabCommand}" CommandParameter="AuditLogs"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Sub-View 1: Invoices Ledger -->
                                <Border Background="#111827" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,20">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AuditActiveSubTab}" Value="Invoices">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <StackPanel>
                                        <TextBlock Text="Decrypted Sales Invoices Ledger" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

                                        <!-- Table Header -->
                                        <Border Background="#1E293B" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="110"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="INVOICE #" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="1" Text="DATE (UTC)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="2" Text="CUSTOMER" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="3" Text="GSTIN" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="4" Text="MODE" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="5" Text="SUBTOTAL" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="6" Text="DISCOUNT" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="7" Text="TAX" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="8" Text="GRAND TOTAL" Foreground="{StaticResource AccentCyanBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>

                                        <!-- Table Items -->
                                        <ItemsControl ItemsSource="{Binding DecryptedAuditInvoices}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#1E293B" CornerRadius="4" Padding="12,8" Margin="0,0,0,4" BorderBrush="#334155" BorderThickness="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="130"/>
                                                                <ColumnDefinition Width="120"/>
                                                                <ColumnDefinition Width="180"/>
                                                                <ColumnDefinition Width="130"/>
                                                                <ColumnDefinition Width="100"/>
                                                                <ColumnDefinition Width="100"/>
                                                                <ColumnDefinition Width="100"/>
                                                                <ColumnDefinition Width="100"/>
                                                                <ColumnDefinition Width="110"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding InvoiceNumber}" Foreground="{StaticResource AccentCyanBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding InvoiceDateUtc, StringFormat='{}{0:dd-MMM-yyyy}'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding CustomerName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding CustomerGSTIN, TargetNullValue='UNREGISTERED'}" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                                                            <Border Grid.Column="4" Background="#0F172A" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding PaymentMethod}" Foreground="#94A3B8" FontSize="10" FontWeight="Bold"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="5" Text="{Binding SubTotal, StringFormat='₹{0:N2}'}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="6" Text="{Binding TotalDiscount, StringFormat='₹{0:N2}'}" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="7" Text="{Binding TotalTax, StringFormat='₹{0:N2}'}" Foreground="{StaticResource WarningAmberBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="8" Text="{Binding GrandTotal, StringFormat='₹{0:N2}'}" Foreground="{StaticResource SuccessGreenBrush}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Sub-View 2: GST Tax & HSN Summary -->
                                <Border Background="#111827" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,20">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AuditActiveSubTab}" Value="TaxSummary">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <StackPanel>
                                        <TextBlock Text="GST Rate Slabs Tax Breakdown" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

                                        <!-- Rate Slabs Table -->
                                        <Border Background="#1E293B" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="160"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="140"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="GST RATE SLAB" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="1" Text="TAXABLE AMOUNT" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="2" Text="CGST AMOUNT" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="3" Text="SGST AMOUNT" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="4" Text="IGST AMOUNT" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="5" Text="TOTAL GST TAX" Foreground="{StaticResource AccentCyanBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding DecryptedGstRateBreakdowns}" Margin="0,0,0,20">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#1E293B" CornerRadius="4" Padding="12,8" Margin="0,0,0,4" BorderBrush="#334155" BorderThickness="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="160"/>
                                                                <ColumnDefinition Width="140"/>
                                                                <ColumnDefinition Width="140"/>
                                                                <ColumnDefinition Width="140"/>
                                                                <ColumnDefinition Width="140"/>
                                                                <ColumnDefinition Width="140"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding RateLabel}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding TaxableAmount, StringFormat='₹{0:N2}'}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding CGSTAmount, StringFormat='₹{0:N2}'}" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding SGSTAmount, StringFormat='₹{0:N2}'}" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="4" Text="{Binding IGSTAmount, StringFormat='₹{0:N2}'}" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="5" Text="{Binding TotalTaxAmount, StringFormat='₹{0:N2}'}" Foreground="{StaticResource SuccessGreenBrush}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="HSN-wise Summary of Inward &amp; Outward Goods" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold" Margin="0,8,0,12"/>

                                        <!-- HSN Table Header -->
                                        <Border Background="#1E293B" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="200"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="120"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="HSN CODE" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="1" Text="DESCRIPTION" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="2" Text="QTY" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="3" Text="TOTAL VALUE" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="4" Text="TAXABLE VAL" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="5" Text="RATE" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="6" Text="TOTAL TAX" Foreground="{StaticResource AccentCyanBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding DecryptedGstHsnSummaries}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#1E293B" CornerRadius="4" Padding="12,8" Margin="0,0,0,4" BorderBrush="#334155" BorderThickness="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="110"/>
                                                                <ColumnDefinition Width="200"/>
                                                                <ColumnDefinition Width="90"/>
                                                                <ColumnDefinition Width="120"/>
                                                                <ColumnDefinition Width="120"/>
                                                                <ColumnDefinition Width="80"/>
                                                                <ColumnDefinition Width="120"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding HSNCode}" Foreground="{StaticResource AccentCyanBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Description}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding TotalQuantity, StringFormat='{}{0:N0}'}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding TotalValue, StringFormat='₹{0:N2}'}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="4" Text="{Binding TaxableValue, StringFormat='₹{0:N2}'}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="5" Text="{Binding GstRate, StringFormat='{}{0}%'}" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="6" Text="{Binding TotalTaxAmount, StringFormat='₹{0:N2}'}" Foreground="{StaticResource SuccessGreenBrush}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Sub-View 3: Inventory Catalog Valuation -->
                                <Border Background="#111827" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,20">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AuditActiveSubTab}" Value="Inventory">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <StackPanel>
                                        <TextBlock Text="Decrypted Client Inventory &amp; Stock Valuation" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

                                        <Border Background="#1E293B" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="200"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="100"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="SKU" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="1" Text="PRODUCT NAME" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="2" Text="HSN CODE" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="3" Text="CATEGORY" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="4" Text="UNIT" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="5" Text="STOCK" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="6" Text="COST PRICE" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="7" Text="SELL PRICE" Foreground="{StaticResource AccentCyanBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding DecryptedAuditProducts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#1E293B" CornerRadius="4" Padding="12,8" Margin="0,0,0,4" BorderBrush="#334155" BorderThickness="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="110"/>
                                                                <ColumnDefinition Width="200"/>
                                                                <ColumnDefinition Width="100"/>
                                                                <ColumnDefinition Width="110"/>
                                                                <ColumnDefinition Width="80"/>
                                                                <ColumnDefinition Width="90"/>
                                                                <ColumnDefinition Width="100"/>
                                                                <ColumnDefinition Width="100"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding SKU}" Foreground="{StaticResource AccentCyanBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding HSNCode}" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding CategoryName}" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="4" Text="{Binding Unit}" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="5" Text="{Binding CurrentStock, StringFormat='{}{0:N0}'}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="6" Text="{Binding PurchasePrice, StringFormat='₹{0:N2}'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="7" Text="{Binding SellingPrice, StringFormat='₹{0:N2}'}" Foreground="{StaticResource SuccessGreenBrush}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Sub-View 4: Tamper-Proof Audit Trail -->
                                <Border Background="#111827" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,20">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AuditActiveSubTab}" Value="AuditLogs">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <StackPanel>
                                        <TextBlock Text="Decrypted Immutable Audit Trail Records" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

                                        <Border Background="#1E293B" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="TIMESTAMP (UTC)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="1" Text="USER" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="2" Text="MODULE" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="3" Text="ACTION" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="4" Text="RECORD ID" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="5" Text="DETAILS / REASON" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                                            </Grid>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding DecryptedAuditLogs}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#1E293B" CornerRadius="4" Padding="12,8" Margin="0,0,0,4" BorderBrush="#334155" BorderThickness="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="130"/>
                                                                <ColumnDefinition Width="110"/>
                                                                <ColumnDefinition Width="110"/>
                                                                <ColumnDefinition Width="110"/>
                                                                <ColumnDefinition Width="140"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding TimestampUtc, StringFormat='{}{0:dd-MMM-yyyy HH:mm}'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Username}" Foreground="{StaticResource AccentCyanBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Module}" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                                                            <Border Grid.Column="3" Background="#0F172A" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Action}" Foreground="#E2E8F0" FontSize="10" FontWeight="Bold"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="4" Text="{Binding RecordId}" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="5" Text="{Binding Reason, TargetNullValue='System Event'}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

            </Grid>
        </Grid>

        <!-- ========================================================================= -->
        <!-- MODAL 1: CONFIRMATION ACTION DIALOG OVERLAY                               -->
        <!-- ========================================================================= -->
        <Grid Background="#D9000000" Visibility="{Binding IsConfirmModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="500" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#0F172A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1.5" CornerRadius="12" Padding="28">
                <StackPanel>
                    <!-- Header -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Background="#1E293B" CornerRadius="8" Padding="10,6" Margin="0,0,12,0">
                            <TextBlock Text="⚠️" FontSize="18"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding ConfirmModalTitle}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="AFS Super Administration Security Check" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Message Body -->
                    <Border Background="#1E293B" CornerRadius="8" Padding="16" Margin="0,0,0,24" BorderBrush="#334155" BorderThickness="1">
                        <TextBlock Text="{Binding ConfirmModalMessage}" Foreground="#E2E8F0" FontSize="14" LineHeight="20" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="❌ Cancel" Style="{StaticResource PrimaryButton}" Background="#334155" Height="44" FontSize="14" FontWeight="SemiBold" Command="{Binding CancelConfirmModalCommand}"/>
                        <Button Grid.Column="2" Content="{Binding ConfirmButtonText}" Style="{StaticResource PrimaryButton}" Background="{Binding ConfirmButtonColor}" Height="44" FontSize="14" FontWeight="Bold" Command="{Binding ExecuteConfirmActionCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- MODAL 2: SUBSCRIPTION UPDATE & RENEWAL SELECTION OVERLAY                  -->
        <!-- ========================================================================= -->
        <Grid Background="#D9000000" Visibility="{Binding IsSubscriptionModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="580" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#0F172A" BorderBrush="{StaticResource AccentCyanBrush}" BorderThickness="1.5" CornerRadius="12" Padding="28">
                <StackPanel>
                    <!-- Header -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Background="#1E293B" CornerRadius="8" Padding="10,6" Margin="0,0,12,0">
                            <TextBlock Text="🔄" FontSize="18"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Update Client Subscription &amp; Plan" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="{Binding UpdateModalBusinessName}" Foreground="{StaticResource AccentCyanBrush}" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Business Identification -->
                    <Border Background="#111827" CornerRadius="8" Padding="14" Margin="0,0,0,18" BorderBrush="#334155" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Business Code: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding UpdateModalBusinessCode}" Foreground="{StaticResource AccentCyanBrush}" FontSize="13" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Subscription Tier Selection -->
                    <TextBlock Text="1. Select Subscription Tier Plan" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding SubscriptionTiers}" SelectedItem="{Binding UpdateSelectedPlan}" Style="{StaticResource ModernComboBox}" Height="44" Margin="0,0,0,16"/>

                    <!-- Renewal Validity Selection -->
                    <TextBlock Text="2. Select Renewal / Extension Period" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding ValidityOptions}" SelectedItem="{Binding UpdateSelectedValidity}" DisplayMemberPath="DisplayText" Style="{StaticResource ModernComboBox}" Height="44" Margin="0,0,0,18"/>

                    <!-- New Calculated Expiry Preview Banner -->
                    <Border Background="#064E3B" CornerRadius="8" Padding="16" Margin="0,0,0,24" BorderBrush="{StaticResource SuccessGreenBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CALCULATED NEW EXPIRATION DATE" Foreground="#A7F3D0" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Text="{Binding UpdateCalculatedExpiryDate, StringFormat='{}{0:dddd, dd MMMM yyyy}'}" Foreground="White" FontSize="15" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#047857" CornerRadius="4" Padding="10,6" VerticalAlignment="Center">
                                <TextBlock Text="VALIDATED" Foreground="White" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Action Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="❌ Cancel" Style="{StaticResource PrimaryButton}" Background="#334155" Height="44" FontSize="14" FontWeight="SemiBold" Command="{Binding CancelSubscriptionModalCommand}"/>
                        <Button Grid.Column="2" Content="✅ Confirm &amp; Update Plan" Style="{StaticResource SuccessButton}" Height="44" FontSize="14" FontWeight="Bold" Command="{Binding ConfirmSubscriptionUpdateCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
