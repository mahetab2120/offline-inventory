                                                        <TextBlock Text=" (" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontWeight="SemiBold"/>
                                                        <TextBlock Text=", " Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding DaysRemaining, StringFormat='{}{0}d left'}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        <TextBlock Text=")" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
