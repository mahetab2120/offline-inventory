                                    <Button Content="📦 General Retail Store" Style="{StaticResource PrimaryButton}" Background="#0F172A" Foreground="{StaticResource TextPrimaryBrush}" Height="36" FontSize="11" FontWeight="Bold" Command="{Binding LoadIndustryPresetCommand}" CommandParameter="General"/>
