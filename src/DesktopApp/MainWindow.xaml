                                                <Grid>
                                                    <TextBlock Text="{Binding}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                                    <Button Content="🗑️" Background="Transparent" Foreground="{StaticResource DangerRedBrush}" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding DataContext.DeleteCustomRackCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <TextBlock Text="{Binding RackCreationMessage}" Foreground="{StaticResource DangerRedBrush}" FontSize="11" Margin="0,0,0,10"/>

                        <!-- Action Buttons -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Cancel" Style="{StaticResource PrimaryButton}" Background="#334155" Height="42" Command="{Binding CloseCreateRackModalCommand}"/>
                            <Button Grid.Column="2" Content="💾 Save &amp; Select Location" Style="{StaticResource SuccessButton}" Height="42" FontSize="14" FontWeight="Bold" Command="{Binding SaveNewRackLocationCommand}"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- STOCK CONTROL & INVENTORY ADJUSTMENT MODAL OVERLAY                        -->
        <!-- ========================================================================= -->
        <Grid Background="#D9000000" Visibility="{Binding IsStockControlModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="640" MaxHeight="850" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#0F172A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1.5" CornerRadius="14" Padding="26">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Header -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📦 " FontSize="20" VerticalAlignment="Center"/>
                                    <TextBlock Text="STOCK CONTROL &amp; ADJUSTMENT" Foreground="{StaticResource AccentCyanBrush}" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Audit-tracked inventory stock inward, write-off, and recount control" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="✕" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}" FontSize="18" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Command="{Binding CloseStockControlModalCommand}"/>
                        </Grid>

                        <!-- Product Overview Card -->
                        <Border Background="#1E293B" CornerRadius="8" Padding="14,10" Margin="0,0,0,14" BorderBrush="#334155" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding SelectedStockProduct.Name}" Foreground="White" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="Item Code: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                        <TextBlock Text="{Binding SelectedStockProduct.SKU}" Foreground="{StaticResource AccentCyanBrush}" FontSize="11" FontWeight="SemiBold"/>
                                        <TextBlock Text=" • Barcode: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="6,0,0,0"/>
                                        <TextBlock Text="{Binding SelectedStockProduct.Barcode}" Foreground="#CBD5E1" FontSize="11"/>
                                        <TextBlock Text=" • Unit: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="6,0,0,0"/>
                                        <TextBlock Text="{Binding SelectedStockProduct.Unit}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="Buy Rate: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                        <TextBlock Text="{Binding SelectedStockProduct.PurchasePrice, StringFormat='₹{0:N2}'}" Foreground="#CBD5E1" FontSize="10"/>
                                        <TextBlock Text=" • Sell Rate: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="6,0,0,0"/>
                                        <TextBlock Text="{Binding SelectedStockProduct.SellingPrice, StringFormat='₹{0:N2}'}" Foreground="{StaticResource SuccessGreenBrush}" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock Text=" • Location: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="6,0,0,0"/>
                                        <TextBlock Text="{Binding SelectedStockProduct.RackLocation, FallbackValue='-', TargetNullValue='-'}" Foreground="#CBD5E1" FontSize="10"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Current Stock Badge -->
                                <Border Grid.Column="1" Background="#0F172A" CornerRadius="8" Padding="12,6" BorderBrush="{StaticResource AccentCyanBrush}" BorderThickness="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="CURRENT STOCK" Foreground="{StaticResource TextSecondaryBrush}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding SelectedStockProduct.CurrentStock, StringFormat='{}{0:0.##}'}" Foreground="{StaticResource AccentCyanBrush}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Operation Mode Selector (3 Buttons) -->
                        <TextBlock Text="ADJUSTMENT TYPE *" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Stock IN Button -->
                            <Button Grid.Column="0" Height="40" Padding="8,0" FontSize="12" FontWeight="Bold" Command="{Binding SetStockAdjustmentTypeCommand}" CommandParameter="Inward">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Setter Property="Background" Value="#1E293B"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StockAdjustmentType}" Value="Inward">
                                                <Setter Property="Background" Value="{StaticResource SuccessGreenBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="➕ " FontSize="13"/>
                                    <TextBlock Text="Stock IN (Inward)"/>
                                </StackPanel>
                            </Button>

                            <!-- Stock OUT Button -->
                            <Button Grid.Column="2" Height="40" Padding="8,0" FontSize="12" FontWeight="Bold" Command="{Binding SetStockAdjustmentTypeCommand}" CommandParameter="Outward">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Setter Property="Background" Value="#1E293B"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StockAdjustmentType}" Value="Outward">
                                                <Setter Property="Background" Value="{StaticResource DangerRedBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="➖ " FontSize="13"/>
                                    <TextBlock Text="Stock OUT (Deduct)"/>
                                </StackPanel>
                            </Button>

                            <!-- Set Count Button -->
                            <Button Grid.Column="4" Height="40" Padding="8,0" FontSize="12" FontWeight="Bold" Command="{Binding SetStockAdjustmentTypeCommand}" CommandParameter="Set">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Setter Property="Background" Value="#1E293B"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StockAdjustmentType}" Value="Set">
                                                <Setter Property="Background" Value="{StaticResource PrimaryBlueBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔄 " FontSize="13"/>
                                    <TextBlock Text="Set Exact Count"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Quantity Input & Fast Preset Pills -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="1.5*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="QUANTITY TO ADJUST *" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding StockAdjustmentQuantity, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.##}'}" Tag="Enter qty..." Style="{StaticResource ModernTextBox}" Height="40" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="FAST PRESET BUTTONS:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                <WrapPanel>
                                    <Button Content="+1" Style="{StaticResource PrimaryButton}" Background="#1E293B" Height="28" Padding="8,0" FontSize="11" Margin="0,0,4,4" Command="{Binding QuickAddAdjustmentQtyCommand}" CommandParameter="1"/>
                                    <Button Content="+5" Style="{StaticResource PrimaryButton}" Background="#1E293B" Height="28" Padding="8,0" FontSize="11" Margin="0,0,4,4" Command="{Binding QuickAddAdjustmentQtyCommand}" CommandParameter="5"/>
                                    <Button Content="+10" Style="{StaticResource PrimaryButton}" Background="#1E293B" Height="28" Padding="8,0" FontSize="11" Margin="0,0,4,4" Command="{Binding QuickAddAdjustmentQtyCommand}" CommandParameter="10"/>
                                    <Button Content="+25" Style="{StaticResource PrimaryButton}" Background="#1E293B" Height="28" Padding="8,0" FontSize="11" Margin="0,0,4,4" Command="{Binding QuickAddAdjustmentQtyCommand}" CommandParameter="25"/>
                                    <Button Content="+50" Style="{StaticResource PrimaryButton}" Background="#1E293B" Height="28" Padding="8,0" FontSize="11" Margin="0,0,4,4" Command="{Binding QuickAddAdjustmentQtyCommand}" CommandParameter="50"/>
                                    <Button Content="+100" Style="{StaticResource PrimaryButton}" Background="#1E293B" Height="28" Padding="8,0" FontSize="11" Margin="0,0,4,4" Command="{Binding QuickAddAdjustmentQtyCommand}" CommandParameter="100"/>
                                    <Button Content="+500" Style="{StaticResource PrimaryButton}" Background="#1E293B" Height="28" Padding="8,0" FontSize="11" Margin="0,0,4,4" Command="{Binding QuickAddAdjustmentQtyCommand}" CommandParameter="500"/>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Live Stock Change Calculation Box -->
                        <Border Background="#111827" CornerRadius="8" Padding="14,10" Margin="0,0,0,14" BorderBrush="{StaticResource AccentCyanBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Current -->
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="Current Stock" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectedStockProduct.CurrentStock, StringFormat='{}{0:0.##}'}" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="➔" Foreground="{StaticResource TextSecondaryBrush}" FontSize="16" VerticalAlignment="Center" Margin="6,0"/>

                                <!-- Change -->
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="Adjustment" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding StockAdjustmentQuantity, StringFormat='{}{0:0.##}'}" Foreground="{StaticResource WarningAmberBrush}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Grid.Column="3" Text="➔" Foreground="{StaticResource TextSecondaryBrush}" FontSize="16" VerticalAlignment="Center" Margin="6,0"/>

                                <!-- Resulting -->
                                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                    <TextBlock Text="Resulting Stock" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding CalculatedNewStock, StringFormat='{}{0:0.##}'}" Foreground="{StaticResource SuccessGreenBrush}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Reason & Reference Info -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Reason for Stock Adjustment *" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,3"/>
                                <ComboBox ItemsSource="{Binding AvailableStockReasons}" SelectedItem="{Binding StockAdjustmentReason}" Style="{StaticResource ModernComboBox}" Height="36" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Ref / Invoice / GRN #" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding StockReferenceNumber, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. GRN-2026-081" Style="{StaticResource ModernTextBox}" Height="36" FontSize="12"/>
                            </StackPanel>
                        </Grid>

                        <!-- Party / Supplier & Rack Location -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Supplier / Party (Optional)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding StockSupplierOrParty, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. Sun Pharma Distributor" Style="{StaticResource ModernTextBox}" Height="36" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Rack / Storage Location" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,3"/>
                                <ComboBox ItemsSource="{Binding AvailableRackLocations}" SelectedItem="{Binding StockUpdatedRack}" Style="{StaticResource ModernComboBox}" Height="36" FontSize="11" ToolTip="{Binding StockUpdatedRack}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Batch Number & Expiry Date (Optional Updates) -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Batch Number (Optional Update)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding StockUpdatedBatch, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. BAT-2609" Style="{StaticResource ModernTextBox}" Height="36" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Expiry Date (Optional Update)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,3"/>
                                <DatePicker SelectedDate="{Binding StockUpdatedExpiry}" Style="{StaticResource ModernDatePicker}" Height="36" FontSize="12"/>
                            </StackPanel>
                        </Grid>

                        <!-- Notes -->
                        <TextBlock Text="Audit Notes / Explanation" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding StockAdjustmentNotes, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. Physical inventory count correction during monthly audit." Style="{StaticResource ModernTextBox}" Height="36" FontSize="12" Margin="0,0,0,12"/>

                        <!-- Message -->
                        <TextBlock Text="{Binding StockControlMessage}" Foreground="{StaticResource SuccessGreenBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,12" TextWrapping="Wrap"/>

                        <!-- Action Buttons -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="❌ Cancel" Style="{StaticResource PrimaryButton}" Background="#334155" Height="42" FontSize="13" Command="{Binding CloseStockControlModalCommand}"/>
                            <Button Grid.Column="2" Content="💾 Confirm &amp; Apply Stock Change" Style="{StaticResource SuccessButton}" Height="42" FontSize="13" FontWeight="Bold" Command="{Binding ConfirmStockAdjustmentCommand}"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- TAX INVOICE & BILL OF SUPPLY PRINT PREVIEW MODAL OVERLAY (A4 / A5 / THERMAL)-->
        <!-- ========================================================================= -->
        <Grid Background="#E6000000" Visibility="{Binding IsPrintPreviewModalOpen, Converter={StaticResource BoolToVis}}">
            <Grid Width="980" MaxWidth="1080" MaxHeight="900" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top Toolbar: Format Switcher & Print Actions -->
                <Border Grid.Row="0" Background="#0F172A" CornerRadius="10,10,0,0" Padding="20,14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Modal Title, Invoice Badge, and Close Button -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Title & Invoice Badge -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🖨️ " FontSize="18" VerticalAlignment="Center"/>
                                <TextBlock Text="GST TAX INVOICE &amp; BILL OF SUPPLY PREVIEW" Foreground="{StaticResource AccentCyanBrush}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Border Background="#1E293B" CornerRadius="4" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center" BorderBrush="#334155" BorderThickness="1">
                                    <TextBlock Text="{Binding SelectedPrintInvoice.InvoiceNumber}" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>

                            <Button Grid.Column="1" Content="✕ Close" Style="{StaticResource PrimaryButton}" Background="#334155" Height="32" Padding="14,0" FontSize="12" Command="{Binding ClosePrintPreviewCommand}"/>
                        </Grid>

                        <!-- Row 1: Format Switcher Tabs (Left) & Target Printer + Direct Print (Right) -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Paper / Printer Size Switcher (Thermal vs A4 vs A5) -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Format: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>

                                <Button Content="🧾 80mm Thermal" Height="34" Padding="12,0" FontSize="11" Margin="0,0,6,0" Command="{Binding SetPrintPreviewModeCommand}" CommandParameter="Thermal">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                            <Setter Property="Background" Value="#1E293B"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PrintPreviewMode}" Value="Thermal">
                                                    <Setter Property="Background" Value="{StaticResource AccentCyanBrush}"/>
                                                    <Setter Property="Foreground" Value="#0F172A"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Content="📄 A4 Full Page" Height="34" Padding="12,0" FontSize="11" Margin="0,0,6,0" Command="{Binding SetPrintPreviewModeCommand}" CommandParameter="A4">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                            <Setter Property="Background" Value="#1E293B"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PrintPreviewMode}" Value="A4">
                                                    <Setter Property="Background" Value="{StaticResource AccentCyanBrush}"/>
                                                    <Setter Property="Foreground" Value="#0F172A"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Content="📑 A5 Half Page" Height="34" Padding="12,0" FontSize="11" Command="{Binding SetPrintPreviewModeCommand}" CommandParameter="A5">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                            <Setter Property="Background" Value="#1E293B"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PrintPreviewMode}" Value="A5">
                                                    <Setter Property="Background" Value="{StaticResource AccentCyanBrush}"/>
                                                    <Setter Property="Foreground" Value="#0F172A"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>

                            <!-- Right: Printer Device Selector & Direct Print Actions -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Printer: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>

                                <!-- Printer Device Dropdown -->
                                <ComboBox ItemsSource="{Binding AvailablePrinters}" SelectedItem="{Binding SelectedPrinter}" Width="200" Height="34" Style="{StaticResource ModernComboBox}" FontSize="11" Margin="0,0,8,0" ToolTip="Select printer device. Selecting Microsoft Print to PDF automatically switches to A4 Full Page!"/>

                                <!-- 1-Click Direct Print Button -->
                                <Button Content="⚡ Direct Print" Style="{StaticResource SuccessButton}" Height="34" Padding="12,0" FontSize="11" FontWeight="Bold" Margin="0,0,6,0" Command="{Binding DirectPrintCurrentInvoiceCommand}" ToolTip="Directly send print job immediately to selected printer"/>

                                <!-- System Print Dialog Button -->
                                <Button Content="⚙️ Print Dialog" Style="{StaticResource PrimaryButton}" Background="#1E293B" Foreground="{StaticResource AccentCyanBrush}" Height="34" Padding="10,0" FontSize="11" FontWeight="SemiBold" Command="{Binding PrintSystemInvoiceCommand}" ToolTip="Open Windows system print dialog"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Document Paper Viewer Area -->
                <Border Grid.Row="1" Background="#090D16" CornerRadius="0,0,10,10" Padding="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" MaxHeight="800">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <StackPanel HorizontalAlignment="Center">

                            <!-- ========================================================= -->
                            <!-- TEMPLATE 1: A4 FULL PAGE TAX INVOICE                      -->
                            <!-- ========================================================= -->
                            <Border Width="760" Background="#FFFFFF" CornerRadius="4" Padding="32,28" BorderBrush="#CBD5E1" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PrintPreviewMode}" Value="A4">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <!-- Store Header -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding CurrentCompany.LegalName}" Foreground="#0F172A" FontSize="20" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding CurrentCompany.TradeName}" Foreground="#334155" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding CurrentCompany.Address}" Foreground="#475569" FontSize="11" Margin="0,2,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding CurrentCompany.City}" Foreground="#475569" FontSize="11"/>
                                                <TextBlock Text=", " Foreground="#475569" FontSize="11"/>
                                                <TextBlock Text="{Binding CurrentCompany.State}" Foreground="#475569" FontSize="11"/>
                                                <TextBlock Text=" - " Foreground="#475569" FontSize="11"/>
                                                <TextBlock Text="{Binding CurrentCompany.Pincode}" Foreground="#475569" FontSize="11"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="GSTIN: " Foreground="#0F172A" FontSize="11" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding CurrentCompany.GSTIN}" Foreground="#0F172A" FontSize="11" FontWeight="Bold" Margin="0,0,14,0"/>
                                                <TextBlock Text="PAN: " Foreground="#0F172A" FontSize="11" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding CurrentCompany.PAN}" Foreground="#0F172A" FontSize="11" FontWeight="Bold"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="Contact: " Foreground="#475569" FontSize="11"/>
                                                <TextBlock Text="{Binding CurrentCompany.ContactPhone}" Foreground="#475569" FontSize="11" Margin="0,0,10,0"/>
                                                <TextBlock Text="Email: " Foreground="#475569" FontSize="11"/>
                                                <TextBlock Text="{Binding CurrentCompany.ContactEmail}" Foreground="#475569" FontSize="11"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <Border Background="#2563EB" CornerRadius="4" Padding="12,5" HorizontalAlignment="Right">
                                                <TextBlock Text="TAX INVOICE (A4)" Foreground="White" FontSize="13" FontWeight="Bold"/>
                                            </Border>
                                            <Border Background="#DCFCE7" BorderBrush="#16A34A" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,6,0,0" HorizontalAlignment="Right">
                                                <TextBlock Text="ORIGINAL FOR RECIPIENT" Foreground="#166534" FontSize="9" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <Rectangle Height="1.5" Fill="#94A3B8" Margin="0,0,0,12"/>

                                    <!-- Invoice & Customer Meta Grid -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: Invoice Info -->
                                        <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10">
                                            <StackPanel>
                                                <TextBlock Text="INVOICE DETAILS" Foreground="#1E293B" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                                <Grid Margin="0,2">
                                                    <TextBlock Text="Invoice No:" Foreground="#64748B" FontSize="11"/>
                                                    <TextBlock Text="{Binding SelectedPrintInvoice.InvoiceNumber}" Foreground="#0F172A" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Grid Margin="0,2">
                                                    <TextBlock Text="Date &amp; Time:" Foreground="#64748B" FontSize="11"/>
                                                    <TextBlock Text="{Binding SelectedPrintInvoice.InvoiceDateUtc, StringFormat='{}{0:dd-MMM-yyyy HH:mm}'}" Foreground="#0F172A" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Grid Margin="0,2">
                                                    <TextBlock Text="Payment Mode:" Foreground="#64748B" FontSize="11"/>
                                                    <TextBlock Text="{Binding SelectedPrintInvoice.PaymentMethod}" Foreground="#16A34A" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Grid Margin="0,2">
                                                    <TextBlock Text="Billed By Cashier:" Foreground="#64748B" FontSize="11"/>
                                                    <TextBlock Text="{Binding SelectedPrintInvoice.CashierUsername}" Foreground="#0F172A" FontSize="11" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Right: Customer Info -->
                                        <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10">
                                            <StackPanel>
                                                <TextBlock Text="BILLED TO (CUSTOMER)" Foreground="#1E293B" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                                <Grid Margin="0,2">
                                                    <TextBlock Text="Customer Name:" Foreground="#64748B" FontSize="11"/>
                                                    <TextBlock Text="{Binding SelectedPrintInvoice.CustomerName}" Foreground="#0F172A" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Grid Margin="0,2">
                                                    <TextBlock Text="Contact Number:" Foreground="#64748B" FontSize="11"/>
                                                    <TextBlock Text="{Binding SelectedPrintInvoice.CustomerPhone}" Foreground="#0F172A" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Grid Margin="0,2">
                                                    <TextBlock Text="State of Supply:" Foreground="#64748B" FontSize="11"/>
                                                    <TextBlock Text="{Binding CurrentCompany.State}" Foreground="#0F172A" FontSize="11" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Grid Margin="0,2">
                                                    <TextBlock Text="Customer GSTIN:" Foreground="#64748B" FontSize="11"/>
                                                    <TextBlock Text="{Binding SelectedPrintInvoice.CustomerGSTIN, FallbackValue='Unregistered (B2C)', TargetNullValue='Unregistered (B2C)'}" Foreground="#0F172A" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Line Items Table -->
                                    <DataGrid ItemsSource="{Binding SelectedPrintInvoice.Items}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              IsReadOnly="True"
                                              Background="Transparent"
                                              RowBackground="#FFFFFF"
                                              AlternatingRowBackground="#F8FAFC"
                                              Foreground="#0F172A"
                                              BorderBrush="#94A3B8"
                                              BorderThickness="1"
                                              GridLinesVisibility="All"
                                              HorizontalGridLinesBrush="#E2E8F0"
                                              VerticalGridLinesBrush="#E2E8F0"
                                              HeadersVisibility="Column"
                                              RowHeight="30"
                                              Margin="0,0,0,14">
                                        <DataGrid.Resources>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="#1E293B"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="FontSize" Value="10"/>
                                                <Setter Property="Padding" Value="6,4"/>
                                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                                <Setter Property="BorderBrush" Value="#475569"/>
                                            </Style>
                                            <Style TargetType="DataGridCell">
                                                <Setter Property="Padding" Value="6,2"/>
                                                <Setter Property="Foreground" Value="#0F172A"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGrid.Resources>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="ITEM DESCRIPTION" Binding="{Binding ProductName}" Width="*"/>
                                            <DataGridTextColumn Header="HSN" Binding="{Binding HSNCode}" Width="70"/>
                                            <DataGridTextColumn Header="QTY" Binding="{Binding Quantity}" Width="50"/>
                                            <DataGridTextColumn Header="UNIT" Binding="{Binding Unit}" Width="50"/>
                                            <DataGridTextColumn Header="RATE (₹)" Binding="{Binding UnitPrice, StringFormat='₹{0:N2}'}" Width="80"/>
                                            <DataGridTextColumn Header="DISCOUNT" Binding="{Binding DiscountAmount, StringFormat='₹{0:N2}'}" Width="75"/>
                                            <DataGridTextColumn Header="TAXABLE" Binding="{Binding TaxableValue, StringFormat='₹{0:N2}'}" Width="80"/>
                                            <DataGridTextColumn Header="GST" Binding="{Binding GSTRate, StringFormat='{}{0}%'}" Width="50"/>
                                            <DataGridTextColumn Header="AMOUNT (₹)" Binding="{Binding TotalAmount, StringFormat='₹{0:N2}'}" Width="85"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <!-- Calculations & Summary Box -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="280"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: Amount in Words & Notes -->
                                        <StackPanel Grid.Column="0">
                                            <Border Background="#F1F5F9" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="AMOUNT IN WORDS:" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding InvoiceAmountInWords}" Foreground="#0F172A" FontSize="11" FontWeight="Bold" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Terms -->
                                            <TextBlock Text="TERMS &amp; CONDITIONS:" Foreground="#475569" FontSize="9" FontWeight="Bold" Margin="0,4,0,2"/>
                                            <TextBlock Text="1. Goods once sold will not be returned without original cash memo." Foreground="#64748B" FontSize="9"/>
                                            <TextBlock Text="2. Disputes subject to local city/state jurisdiction." Foreground="#64748B" FontSize="9"/>
                                            <TextBlock Text="3. This is a computer generated tax invoice." Foreground="#64748B" FontSize="9"/>
                                        </StackPanel>

                                        <!-- Right: Tax & Grand Total -->
                                        <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#94A3B8" BorderThickness="1" CornerRadius="4" Padding="12">
                                            <StackPanel>
                                                <Grid Margin="0,2">
                                                    <TextBlock Text="Gross Subtotal:" Foreground="#475569" FontSize="11"/>
                                                    <TextBlock Text="{Binding SelectedPrintInvoice.SubTotal, StringFormat='₹{0:N2}'}" Foreground="#0F172A" FontSize="11" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Grid Margin="0,2">
                                                    <TextBlock Text="Discount Applied (Admin):" Foreground="#D97706" FontSize="11" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding SelectedPrintInvoice.TotalDiscount, StringFormat='-₹{0:N2}'}" Foreground="#D97706" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Grid Margin="0,2">
                                                    <TextBlock Text="Taxable Subtotal:" Foreground="#475569" FontSize="11"/>
                                                    <TextBlock Text="{Binding SelectedPrintInvoice.TaxableAmount, StringFormat='₹{0:N2}'}" Foreground="#0F172A" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Grid Margin="0,2">
                                                    <TextBlock Text="CGST (Central Tax):" Foreground="#475569" FontSize="11"/>
                                                    <TextBlock Text="{Binding SelectedPrintInvoice.TotalCGST, StringFormat='₹{0:N2}'}" Foreground="#0F172A" FontSize="11" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Grid Margin="0,2">
                                                    <TextBlock Text="SGST (State Tax):" Foreground="#475569" FontSize="11"/>
                                                    <TextBlock Text="{Binding SelectedPrintInvoice.TotalSGST, StringFormat='₹{0:N2}'}" Foreground="#0F172A" FontSize="11" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Rectangle Height="1" Fill="#CBD5E1" Margin="0,4"/>
                                                <Grid Margin="0,2">
                                                    <TextBlock Text="Total GST Amount:" Foreground="#0F172A" FontSize="11" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding SelectedPrintInvoice.TotalTax, StringFormat='₹{0:N2}'}" Foreground="#0F172A" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Rectangle Height="1.5" Fill="#0F172A" Margin="0,4"/>
                                                <Grid Margin="0,2">
                                                    <TextBlock Text="NET AMOUNT PAYABLE:" Foreground="#0F172A" FontSize="12" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding SelectedPrintInvoice.GrandTotal, StringFormat='₹{0:N2}'}" Foreground="#16A34A" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Signatory Footer -->
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                                            <TextBlock Text="Thank you for your business!" Foreground="#0F172A" FontSize="11" FontWeight="SemiBold" FontStyle="Italic"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding CurrentCompany.LegalName, StringFormat='For {0}'}" Foreground="#0F172A" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            <Border Height="36"/>
                                            <TextBlock Text="Authorized Signatory" Foreground="#475569" FontSize="10" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ========================================================= -->
                            <!-- TEMPLATE 2: A5 HALF PAGE TAX INVOICE                      -->
                            <!-- ========================================================= -->
                            <Border Width="620" Background="#FFFFFF" CornerRadius="4" Padding="22,18" BorderBrush="#CBD5E1" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PrintPreviewMode}" Value="A5">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <!-- A5 Header -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding CurrentCompany.LegalName}" Foreground="#0F172A" FontSize="16" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding CurrentCompany.Address}" Foreground="#475569" FontSize="10"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="GSTIN: " Foreground="#0F172A" FontSize="10" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding CurrentCompany.GSTIN}" Foreground="#0F172A" FontSize="10" FontWeight="Bold" Margin="0,0,8,0"/>
                                                <TextBlock Text="Ph: " Foreground="#475569" FontSize="10"/>
                                                <TextBlock Text="{Binding CurrentCompany.ContactPhone}" Foreground="#475569" FontSize="10"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <Border Background="#1E293B" CornerRadius="3" Padding="8,3">
                                                <TextBlock Text="TAX INVOICE (A5)" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock Text="{Binding SelectedPrintInvoice.InvoiceNumber}" Foreground="#0F172A" FontSize="11" FontWeight="Bold" Margin="0,3,0,0" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding SelectedPrintInvoice.InvoiceDateUtc, StringFormat='{}{0:dd-MMM-yyyy HH:mm}'}" Foreground="#64748B" FontSize="9" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>

                                    <Rectangle Height="1" Fill="#94A3B8" Margin="0,0,0,6"/>

                                    <!-- Customer Details Banner -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Customer: " Foreground="#64748B" FontSize="10"/>
                                                <TextBlock Text="{Binding SelectedPrintInvoice.CustomerName}" Foreground="#0F172A" FontSize="10" FontWeight="Bold"/>
                                                <TextBlock Text=" (" Foreground="#64748B" FontSize="10"/>
                                                <TextBlock Text="{Binding SelectedPrintInvoice.CustomerPhone}" Foreground="#0F172A" FontSize="10"/>
                                                <TextBlock Text=")" Foreground="#64748B" FontSize="10"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="Cust GSTIN: " Foreground="#64748B" FontSize="9"/>
                                                <TextBlock Text="{Binding SelectedPrintInvoice.CustomerGSTIN, FallbackValue='B2C / Unregistered', TargetNullValue='B2C / Unregistered'}" Foreground="#0F172A" FontSize="9" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Payment: " Foreground="#64748B" FontSize="10"/>
                                            <TextBlock Text="{Binding SelectedPrintInvoice.PaymentMethod}" Foreground="#16A34A" FontSize="10" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Line Items Table (A5 Compact) -->
                                    <DataGrid ItemsSource="{Binding SelectedPrintInvoice.Items}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              IsReadOnly="True"
                                              Background="Transparent"
                                              RowBackground="#FFFFFF"
                                              Foreground="#0F172A"
                                              BorderBrush="#CBD5E1"
                                              BorderThickness="1"
                                              GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="#E2E8F0"
                                              RowHeight="24"
                                              Margin="0,0,0,8">
                                        <DataGrid.Resources>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="#334155"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="FontSize" Value="9"/>
                                                <Setter Property="Padding" Value="4,2"/>
                                            </Style>
                                            <Style TargetType="DataGridCell">
                                                <Setter Property="Padding" Value="4,1"/>
                                                <Setter Property="FontSize" Value="10"/>
                                                <Setter Property="Foreground" Value="#0F172A"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                            </Style>
                                        </DataGrid.Resources>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="ITEM NAME" Binding="{Binding ProductName}" Width="*"/>
                                            <DataGridTextColumn Header="HSN" Binding="{Binding HSNCode}" Width="55"/>
                                            <DataGridTextColumn Header="QTY" Binding="{Binding Quantity}" Width="40"/>
                                            <DataGridTextColumn Header="RATE" Binding="{Binding UnitPrice, StringFormat='₹{0:N2}'}" Width="65"/>
                                            <DataGridTextColumn Header="DISC" Binding="{Binding DiscountAmount, StringFormat='₹{0:N2}'}" Width="55"/>
                                            <DataGridTextColumn Header="GST" Binding="{Binding GSTRate, StringFormat='{}{0}%'}" Width="40"/>
                                            <DataGridTextColumn Header="AMOUNT" Binding="{Binding TotalAmount, StringFormat='₹{0:N2}'}" Width="75"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <!-- Summary Grid -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding InvoiceAmountInWords}" Foreground="#0F172A" FontSize="9" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="Thank you for your visit!" Foreground="#64748B" FontSize="8" Margin="0,4,0,0" FontStyle="Italic"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <Grid Margin="0,1">
                                                <TextBlock Text="Discount Applied:" Foreground="#D97706" FontSize="10"/>
                                                <TextBlock Text="{Binding SelectedPrintInvoice.TotalDiscount, StringFormat='-₹{0:N2}'}" Foreground="#D97706" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,1">
                                                <TextBlock Text="Subtotal (Taxable):" Foreground="#64748B" FontSize="10"/>
                                                <TextBlock Text="{Binding SelectedPrintInvoice.TaxableAmount, StringFormat='₹{0:N2}'}" Foreground="#0F172A" FontSize="10" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,1">
                                                <TextBlock Text="GST Tax Total:" Foreground="#64748B" FontSize="10"/>
                                                <TextBlock Text="{Binding SelectedPrintInvoice.TotalTax, StringFormat='₹{0:N2}'}" Foreground="#0F172A" FontSize="10" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Rectangle Height="1" Fill="#0F172A" Margin="0,2"/>
                                            <Grid Margin="0,1">
                                                <TextBlock Text="TOTAL PAYABLE:" Foreground="#0F172A" FontSize="11" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding SelectedPrintInvoice.GrandTotal, StringFormat='₹{0:N2}'}" Foreground="#16A34A" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ========================================================= -->
                            <!-- TEMPLATE 3: 80MM (3-INCH) POS THERMAL RECEIPT SLIP        -->
                            <!-- ========================================================= -->
                            <Border Width="340" Background="#FFFFFF" CornerRadius="4" Padding="16,14" BorderBrush="#CBD5E1" BorderThickness="1" TextElement.FontFamily="Consolas, Courier New, Segoe UI">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PrintPreviewMode}" Value="Thermal">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <!-- Thermal Header -->
                                    <TextBlock Text="{Binding CurrentCompany.LegalName}" Foreground="#000000" FontSize="15" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding CurrentCompany.TradeName}" Foreground="#333333" FontSize="11" TextAlignment="Center" Margin="0,1,0,0"/>
                                    <TextBlock Text="{Binding CurrentCompany.Address}" Foreground="#444444" FontSize="9" TextAlignment="Center" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                    <TextBlock Text="{Binding CurrentCompany.ContactPhone, StringFormat='Ph: {0}'}" Foreground="#444444" FontSize="9" TextAlignment="Center"/>
                                    <TextBlock Text="{Binding CurrentCompany.GSTIN, StringFormat='GSTIN: {0}'}" Foreground="#000000" FontSize="10" FontWeight="Bold" TextAlignment="Center" Margin="0,2,0,0"/>

                                    <TextBlock Text="----------------------------------------" Foreground="#000000" FontSize="10" TextAlignment="Center" Margin="0,4,0,4"/>

                                    <Grid Margin="0,1">
                                        <TextBlock Text="Invoice #:" Foreground="#000000" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding SelectedPrintInvoice.InvoiceNumber}" Foreground="#000000" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,1">
                                        <TextBlock Text="Date/Time:" Foreground="#444444" FontSize="9"/>
                                        <TextBlock Text="{Binding SelectedPrintInvoice.InvoiceDateUtc, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Foreground="#000000" FontSize="9" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,1">
                                        <TextBlock Text="Customer:" Foreground="#444444" FontSize="9"/>
                                        <TextBlock Text="{Binding SelectedPrintInvoice.CustomerName}" Foreground="#000000" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,1">
                                        <TextBlock Text="Cust GSTIN:" Foreground="#444444" FontSize="9"/>
                                        <TextBlock Text="{Binding SelectedPrintInvoice.CustomerGSTIN, FallbackValue='-', TargetNullValue='-'}" Foreground="#000000" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,1">
                                        <TextBlock Text="Cashier:" Foreground="#444444" FontSize="9"/>
                                        <TextBlock Text="{Binding SelectedPrintInvoice.CashierUsername}" Foreground="#000000" FontSize="9" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <TextBlock Text="========================================" Foreground="#000000" FontSize="10" TextAlignment="Center" Margin="0,4,0,4"/>

                                    <!-- Table Header -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="35"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="65"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="ITEM" Foreground="#000000" FontSize="9" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="1" Text="QTY" Foreground="#000000" FontSize="9" FontWeight="Bold" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="RATE" Foreground="#000000" FontSize="9" FontWeight="Bold" TextAlignment="Right"/>
                                        <TextBlock Grid.Column="3" Text="AMT" Foreground="#000000" FontSize="9" FontWeight="Bold" TextAlignment="Right"/>
                                    </Grid>

                                    <TextBlock Text="----------------------------------------" Foreground="#000000" FontSize="10" TextAlignment="Center" Margin="0,0,0,4"/>

                                    <!-- Item Rows -->
                                    <ItemsControl ItemsSource="{Binding SelectedPrintInvoice.Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,2">
                                                    <TextBlock Text="{Binding ProductName}" Foreground="#000000" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <Grid Margin="0,1,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="35"/>
                                                            <ColumnDefinition Width="50"/>
                                                            <ColumnDefinition Width="65"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding HSNCode, StringFormat='HSN: {0}'}" Foreground="#555555" FontSize="8"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Quantity}" Foreground="#000000" FontSize="9" TextAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding UnitPrice, StringFormat='₹{0:N0}'}" Foreground="#000000" FontSize="9" TextAlignment="Right"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding TotalAmount, StringFormat='₹{0:N2}'}" Foreground="#000000" FontSize="9" FontWeight="Bold" TextAlignment="Right"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding DiscountAmount, StringFormat='  *Item Disc: -₹{0:N2}'}" Foreground="#333333" FontSize="8">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasDiscount}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="----------------------------------------" Foreground="#000000" FontSize="10" TextAlignment="Center" Margin="0,4,0,4"/>

                                    <!-- Totals -->
                                    <Grid Margin="0,1">
                                        <TextBlock Text="Gross Subtotal:" Foreground="#444444" FontSize="9"/>
                                        <TextBlock Text="{Binding SelectedPrintInvoice.SubTotal, StringFormat='₹{0:N2}'}" Foreground="#000000" FontSize="9" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,1">
                                        <TextBlock Text="Discount (Admin):" Foreground="#444444" FontSize="9"/>
                                        <TextBlock Text="{Binding SelectedPrintInvoice.TotalDiscount, StringFormat='-₹{0:N2}'}" Foreground="#000000" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,1">
                                        <TextBlock Text="Taxable Subtotal:" Foreground="#444444" FontSize="9"/>
                                        <TextBlock Text="{Binding SelectedPrintInvoice.TaxableAmount, StringFormat='₹{0:N2}'}" Foreground="#000000" FontSize="9" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,1">
                                        <TextBlock Text="CGST Amount:" Foreground="#444444" FontSize="9"/>
                                        <TextBlock Text="{Binding SelectedPrintInvoice.TotalCGST, StringFormat='₹{0:N2}'}" Foreground="#000000" FontSize="9" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,1">
                                        <TextBlock Text="SGST Amount:" Foreground="#444444" FontSize="9"/>
                                        <TextBlock Text="{Binding SelectedPrintInvoice.TotalSGST, StringFormat='₹{0:N2}'}" Foreground="#000000" FontSize="9" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <TextBlock Text="========================================" Foreground="#000000" FontSize="10" TextAlignment="Center" Margin="0,4,0,4"/>

                                    <!-- Grand Total -->
                                    <Grid Margin="0,2">
                                        <TextBlock Text="NET PAYABLE:" Foreground="#000000" FontSize="13" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding SelectedPrintInvoice.GrandTotal, StringFormat='₹{0:N2}'}" Foreground="#000000" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Grid Margin="0,1">
                                        <TextBlock Text="Mode of Payment:" Foreground="#444444" FontSize="9"/>
                                        <TextBlock Text="{Binding SelectedPrintInvoice.PaymentMethod}" Foreground="#000000" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <TextBlock Text="----------------------------------------" Foreground="#000000" FontSize="10" TextAlignment="Center" Margin="0,6,0,4"/>

                                    <!-- Footer & Barcode Simulation -->
                                    <TextBlock Text="★ THANK YOU! VISIT AGAIN! ★" Foreground="#000000" FontSize="10" FontWeight="Bold" TextAlignment="Center"/>
                                    <TextBlock Text="Goods once sold cannot be returned." Foreground="#555555" FontSize="8" TextAlignment="Center" Margin="0,2,0,0"/>

                                    <Border Height="24" Background="#E2E8F0" Margin="10,6" CornerRadius="2">
                                        <TextBlock Text="{Binding SelectedPrintInvoice.InvoiceNumber, StringFormat='|| | |||| | ||| {0} |||| | || |'}" Foreground="#000000" FontSize="10" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- ========================================================================= -->
        <!-- CONFIRMATION ACTION DIALOG OVERLAY (ALL SCREENS)                          -->
        <!-- ========================================================================= -->
        <Grid Background="#D9000000" Visibility="{Binding IsConfirmModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="500" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#0F172A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1.5" CornerRadius="12" Padding="28">
                <StackPanel>
                    <!-- Header -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Background="#1E293B" CornerRadius="8" Padding="10,6" Margin="0,0,12,0">
                            <TextBlock Text="⚠️" FontSize="18"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding ConfirmModalTitle}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="Store Management Operational Confirmation" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Message Body -->
                    <Border Background="#1E293B" CornerRadius="8" Padding="16" Margin="0,0,0,24" BorderBrush="#334155" BorderThickness="1">
                        <TextBlock Text="{Binding ConfirmModalMessage}" Foreground="#E2E8F0" FontSize="14" LineHeight="20" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="❌ Cancel" Style="{StaticResource PrimaryButton}" Background="#334155" Height="44" FontSize="14" FontWeight="SemiBold" Command="{Binding CancelConfirmModalCommand}"/>
                        <Button Grid.Column="2" Content="{Binding ConfirmButtonText}" Style="{StaticResource PrimaryButton}" Background="{Binding ConfirmButtonBrush}" Height="44" FontSize="14" FontWeight="Bold" Command="{Binding ExecuteConfirmActionCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- LICENSE RENEWAL & CERTIFICATE IMPORT MODAL OVERLAY                        -->
        <!-- ========================================================================= -->
        <Grid Background="#D9000000" Visibility="{Binding IsLicenseRenewalModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="640" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#0F172A" BorderBrush="{StaticResource AccentCyanBrush}" BorderThickness="1.5" CornerRadius="12" Padding="28">
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Border Background="#1E1B4B" CornerRadius="8" Padding="10,6" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="🔄" FontSize="20"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Apply License Renewal Certificate" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="Apply RSA-4096 signed .lic certificate or updated .key file from Super Admin" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Style="{StaticResource PrimaryButton}" Background="#334155" Width="32" Height="32" Padding="0" FontSize="14" Command="{Binding CloseLicenseRenewalModalCommand}"/>
                    </Grid>

                    <!-- Active License Status Card -->
                    <Border Background="#111827" CornerRadius="8" Padding="14" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="ACTIVE STORE SUBSCRIPTION" Foreground="{StaticResource AccentCyanBrush}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding CurrentCompany.LegalName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="Bold" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding CurrentLicense.Plan, StringFormat='Tier: {0} Plan'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="REMAINING DURATION" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding LicenseDaysRemainingText}" Foreground="{StaticResource SuccessGreenBrush}" FontSize="12" FontWeight="Bold" Margin="0,2,0,0" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- File Picker -->
                    <TextBlock Text="Select License Certificate (.lic) or Provisioning Key (.key) *" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding SelectedRenewalFilePath}" IsReadOnly="True" Style="{StaticResource ModernTextBox}" Height="42" FontSize="12"/>
                        <Button Grid.Column="2" Content="📂 Browse File..." Style="{StaticResource PrimaryButton}" Background="{StaticResource SurfaceCardBrush}" Height="42" Padding="16,0" FontSize="12" FontWeight="Bold" Command="{Binding BrowseLicenseRenewalFileCommand}"/>
                    </Grid>

                    <!-- Validation Message -->
                    <TextBlock Text="{Binding RenewalValidationMessage}" Foreground="{StaticResource AccentCyanBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,14" TextWrapping="Wrap"/>

                    <!-- Verified Certificate Preview -->
                    <Border Background="#1E293B" CornerRadius="8" Padding="14" Margin="0,0,0,20" BorderBrush="#334155" BorderThickness="1" Visibility="{Binding IsValidRenewalLoaded, Converter={StaticResource BoolToVis}}">
                        <TextBox Text="{Binding RenewalPreviewSummary}" IsReadOnly="True" Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="❌ Cancel" Style="{StaticResource PrimaryButton}" Background="#334155" Height="44" FontSize="14" FontWeight="SemiBold" Command="{Binding CloseLicenseRenewalModalCommand}"/>
                        <Button Grid.Column="2" Content="✅ Apply &amp; Activate Renewal" Style="{StaticResource SuccessButton}" Height="44" FontSize="14" FontWeight="Bold" IsEnabled="{Binding IsValidRenewalLoaded}" Command="{Binding ApplyLicenseRenewalCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
