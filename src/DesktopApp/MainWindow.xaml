<Window x:Class="DesktopApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DesktopApp.ViewModels"
        mc:Ignorable="d"
        Title="AFS Commercial Business Management, POS Billing &amp; Inventory Suite" 
        Height="900" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        FontFamily="{StaticResource ModernFont}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <!-- ========================================================================= -->
        <!-- STATE 1: ONBOARDING LOCK SCREEN (First-time CA Encrypted Data Key Upload) -->
        <!-- ========================================================================= -->
        <Grid Background="{StaticResource BgDarkBrush}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentViewState}" Value="OnboardingLock">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Width="680" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource ModernCard}" Padding="36">
                <StackPanel>
                    <!-- Security Badge Header -->
                    <Border Background="#1E293B" CornerRadius="20" Padding="12,6" HorizontalAlignment="Left" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔒 OFFLINE ACTIVATION REQUIRED" Foreground="{StaticResource WarningAmberBrush}" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Business Setup &amp; Key Activation" Foreground="{StaticResource TextPrimaryBrush}" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="This system operates in an uninitialized state until provisioned by AFS. Please upload the Encrypted Business Data Key (.key) provided to you." 
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,24"/>

                    <!-- Drag & Drop / File Selector Box -->
                    <Border Background="#0F172A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="2" CornerRadius="8" Padding="24" Margin="0,0,0,20">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📁" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Upload AFS-Issued Encrypted Data Key" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Supported formats: .key, .dat (RSA-2048 / AES-256-GCM signed package)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,14"/>

                            <Button Content="📂 Browse &amp; Select Data Key File..." Style="{StaticResource PrimaryButton}" Command="{Binding BrowseDataKeyFileCommand}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Validation Status Message -->
                    <TextBlock Text="{Binding ValidationMessage}" Foreground="{StaticResource SuccessGreenBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <!-- Verified Key Information Card -->
                    <Border Background="#1E293B" BorderBrush="{StaticResource AccentCyanBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,20" Visibility="{Binding IsValidKeyLoaded, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="VERIFIED BUSINESS IDENTITY &amp; LICENSE" Foreground="{StaticResource AccentCyanBrush}" FontSize="11" FontWeight="Bold"/>
                            <TextBox Text="{Binding PreviewSummary}" IsReadOnly="True" Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" FontFamily="Consolas" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Action Button -->
                    <Button Content="🚀 Activate &amp; Bootstrap Business Database" Style="{StaticResource SuccessButton}" FontSize="15" Height="44" Command="{Binding ActivateAndBootstrapBusinessCommand}" IsEnabled="{Binding IsValidKeyLoaded}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- STATE 2: STORE LOGIN SCREEN                                               -->
        <!-- ========================================================================= -->
        <Grid Background="{StaticResource BgDarkBrush}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentViewState}" Value="Login">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource ModernCard}" Padding="40">
                <StackPanel>
                    <TextBlock Text="{Binding CurrentCompany.TradeName, FallbackValue='Business Management'}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentCompany.LegalName, FallbackValue='Offline POS &amp; Inventory Suite'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" HorizontalAlignment="Center" Margin="0,4,0,24"/>

                    <Border Background="#111827" CornerRadius="8" Padding="12" Margin="0,0,0,24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔒 Business Code: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="{Binding CurrentCompany.BusinessCode}" Foreground="{StaticResource AccentCyanBrush}" FontSize="12" FontWeight="Bold"/>
                        </Grid>
                    </Border>

                    <!-- Username -->
                    <TextBlock Text="Operator / Admin Username" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding LoginUsername, UpdateSourceTrigger=PropertyChanged}" Tag="Enter admin / staff username (e.g. admin)" Style="{StaticResource ModernTextBox}" Height="48" FontSize="15" Margin="0,0,0,16"/>

                    <!-- Password with Show/Hide Toggle -->
                    <TextBlock Text="Password" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <PasswordBox x:Name="StorePasswordBox"
                                     Grid.Column="0"
                                     Tag="Enter account password"
                                     Style="{StaticResource ModernPasswordBox}"
                                     Height="48"
                                     FontSize="18"
                                     PasswordChar="●"
                                     PasswordChanged="StorePasswordBox_PasswordChanged"
                                     Visibility="{Binding IsPasswordMasked, Converter={StaticResource BoolToVis}}"/>

                        <TextBox Grid.Column="0"
                                 Text="{Binding LoginPassword, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Enter account password"
                                 Style="{StaticResource ModernTextBox}"
                                 Height="48"
                                 FontSize="15"
                                 Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVis}}"/>

                        <Button Grid.Column="1"
                                Content="{Binding PasswordToggleIcon}"
                                Style="{StaticResource PrimaryButton}"
                                Background="{StaticResource SurfaceCardBrush}"
                                Foreground="{StaticResource AccentCyanBrush}"
                                Height="48"
                                FontSize="13"
                                FontWeight="Bold"
                                Padding="16,0"
                                Margin="8,0,0,0"
                                Command="{Binding TogglePasswordVisibilityCommand}"/>
                    </Grid>

                    <TextBlock Text="{Binding LoginErrorMessage}" Foreground="{StaticResource DangerRedBrush}" FontSize="13" Margin="0,0,0,16" TextWrapping="Wrap" FontWeight="SemiBold"/>

                    <Button Content="🚀 Sign In to Store Dashboard" Style="{StaticResource PrimaryButton}" Height="48" FontSize="16" Command="{Binding PerformLoginCommand}" Margin="0,0,0,14"/>

                    <!-- Role Access Quick Hints -->
                    <Border Background="#0B0F17" CornerRadius="6" Padding="12,8" BorderBrush="#1E293B" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="💡 Business Store Access:" Foreground="{StaticResource AccentCyanBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,3"/>
                            <TextBlock Text="• Sign in with your Business Admin or Staff credentials" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- STATE 3: COMPLETE COMMERCIAL STORE DASHBOARD & BILLING SUITE              -->
        <!-- ========================================================================= -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentViewState}" Value="Dashboard">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header & Navigation Bar -->
            <Border Grid.Row="0" Background="#111827" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Brand Info -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,30,0">
                        <Border Background="{StaticResource PrimaryBlueBrush}" Width="36" Height="36" CornerRadius="8" Margin="0,0,10,0">
                            <TextBlock Text="📦" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentCompany.TradeName, FallbackValue='AFS Business App'}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="{Binding CurrentCompany.BusinessCode}" Foreground="{StaticResource AccentCyanBrush}" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Main Navigation Tabs -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton GroupName="MainDashboardTabs" Content="🏠 Dashboard" Style="{StaticResource ModernNavRadioButton}" IsChecked="True" Command="{Binding SwitchTabCommand}" CommandParameter="Dashboard"/>
                        <RadioButton GroupName="MainDashboardTabs" Content="🛒 POS Billing" Style="{StaticResource ModernNavRadioButton}" Command="{Binding SwitchTabCommand}" CommandParameter="Billing"/>
                        <RadioButton GroupName="MainDashboardTabs" Content="📦 Inventory" Style="{StaticResource ModernNavRadioButton}" Command="{Binding SwitchTabCommand}" CommandParameter="Inventory"/>
                        <RadioButton GroupName="MainDashboardTabs" Content="💊 Pharmacy Batches" Style="{StaticResource ModernNavRadioButton}" Command="{Binding SwitchTabCommand}" CommandParameter="Pharmacy"/>
                        <RadioButton GroupName="MainDashboardTabs" Content="👥 Users &amp; Roles" Style="{StaticResource ModernNavRadioButton}" Command="{Binding SwitchTabCommand}" CommandParameter="Users"/>
                        <RadioButton GroupName="MainDashboardTabs" Content="🔐 CA Encrypted Export" Style="{StaticResource ModernNavRadioButton}" Visibility="{Binding CanAccessSuperAdminExport, Converter={StaticResource BoolToVis}}" Command="{Binding SwitchTabCommand}" CommandParameter="CaExport"/>
                    </StackPanel>

                    <!-- Right User Info & Logout -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#111827" CornerRadius="16" Padding="12,4" Margin="0,0,14,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🛡️ " FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding LicenseDaysRemainingText}" Foreground="{StaticResource SuccessGreenBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Button Content="🔄 Renew" Style="{StaticResource PrimaryButton}" Background="#1E293B" Padding="8,2" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding CanAccessSuperAdminExport, Converter={StaticResource BoolToVis}}" Command="{Binding OpenLicenseRenewalModalCommand}" ToolTip="Apply New License Certificate (.lic) or Key from Super Admin"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="0,0,14,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding CurrentUser.FullName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CurrentUser.Role}" Foreground="{StaticResource AccentCyanBrush}" FontSize="11" HorizontalAlignment="Right"/>
                        </StackPanel>

                        <Button Content="Logout" Style="{StaticResource PrimaryButton}" Background="{StaticResource SurfaceCardBrush}" Padding="12,6" FontSize="12" Command="{Binding LogoutCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Tabbed Content Area -->
            <Grid Grid.Row="1" Margin="20">

                <!-- ================================================================= -->
                <!-- TAB 1: EXECUTIVE BUSINESS DASHBOARD                               -->
                <!-- ================================================================= -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentDashboardTab}" Value="Dashboard">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- KPI Cards Ribbon -->
                            <UniformGrid Columns="6" Margin="0,0,0,18">
                                <!-- KPI 1: Today's Revenue -->
                                <Border Style="{StaticResource ModernCard}" Margin="0,0,8,0" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="TODAY'S REVENUE" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding TodaySalesTotal, StringFormat='₹{0:N2}'}" Foreground="{StaticResource SuccessGreenBrush}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding TodayInvoiceCount, StringFormat='{}{0} Invoices Settled'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- KPI 2: Monthly Turnover -->
                                <Border Style="{StaticResource ModernCard}" Margin="4,0,4,0" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="MONTHLY TURNOVER" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding MonthlyTurnover, StringFormat='₹{0:N2}'}" Foreground="{StaticResource AccentCyanBrush}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                                        <TextBlock Text="Active Billing Cycle" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- KPI 3: Inventory Valuation -->
                                <Border Style="{StaticResource ModernCard}" Margin="4,0,4,0" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="INVENTORY VALUE" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding TotalInventoryValue, StringFormat='₹{0:N0}'}" Foreground="#A5B4FC" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding TotalProductCount, StringFormat='{}{0} Products in Catalog'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- KPI 4: Low Stock Warnings -->
                                <Border Style="{StaticResource ModernCard}" Margin="4,0,4,0" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="LOW STOCK ALERTS" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding LowStockCount}" Foreground="{StaticResource WarningAmberBrush}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                                        <TextBlock Text="Items below threshold" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- KPI 5: Pharmacy Expiring -->
                                <Border Style="{StaticResource ModernCard}" Margin="4,0,4,0" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="PHARMACY BATCHES" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding PharmacyExpiredCount, StringFormat='{}{0} Expired'}" Foreground="{StaticResource DangerRedBrush}" FontSize="16" FontWeight="Bold" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding PharmacyNearExpiryCount, StringFormat='{}{0} Near Expiry (&lt;60d)'}" Foreground="{StaticResource WarningAmberBrush}" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- KPI 6: Active Staff -->
                                <Border Style="{StaticResource ModernCard}" Margin="8,0,0,0" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="ACTIVE OPERATORS" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding ActiveStaffCount, StringFormat='{}{0} Users'}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                                        <TextBlock Text="Logged in &amp; ready" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Visual Charts Section -->
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Chart 1: Weekly Revenue Trend -->
                                <Border Grid.Column="0" Style="{StaticResource ModernCard}" Padding="20">
                                    <StackPanel>
                                        <TextBlock Text="WEEKLY SALES REVENUE TREND" Foreground="{StaticResource AccentCyanBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,0,14"/>
                                        <ItemsControl ItemsSource="{Binding WeeklySalesTrends}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1" Height="170" VerticalAlignment="Bottom"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="10,0">
                                                        <TextBlock Text="{Binding FormattedAmount}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                        <Border Background="{StaticResource PrimaryBlueBrush}" Width="36" Height="{Binding BarHeight}" CornerRadius="4,4,0,0"/>
                                                        <TextBlock Text="{Binding DayName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Chart 2: Category Distribution -->
                                <Border Grid.Column="2" Style="{StaticResource ModernCard}" Padding="20">
                                    <StackPanel>
                                        <TextBlock Text="CATEGORY STOCK &amp; INVENTORY SHARE" Foreground="{StaticResource AccentCyanBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,0,14"/>
                                        <ItemsControl ItemsSource="{Binding CategoryDistributions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid Grid.Row="0" Margin="0,0,0,4">
                                                            <TextBlock Text="{Binding CategoryName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding FormattedPercentage}" Foreground="{StaticResource AccentCyanBrush}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                        <ProgressBar Grid.Row="1" Value="{Binding Percentage}" Maximum="100" Height="8" Foreground="{StaticResource AccentCyanBrush}" Background="#0F172A" BorderThickness="0"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Bottom Alerts & Action Center -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Low Stock Warnings Grid -->
                                <Border Grid.Column="0" Style="{StaticResource ModernCard}" Padding="18">
                                    <StackPanel>
                                        <TextBlock Text="⚠️ LOW STOCK REORDER RECOMMENDATIONS" Foreground="{StaticResource WarningAmberBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>
                                        <ItemsControl ItemsSource="{Binding LowStockProducts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#0F172A" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding SKU, StringFormat='SKU: {0}'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                                            </StackPanel>
                                                            <Border Grid.Column="1" Background="#78350F" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding CurrentStock, StringFormat='Stock: {0}'}" Foreground="#FDE68A" FontSize="11" FontWeight="Bold"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Pharmacy Expiry Alert Grid -->
                                <Border Grid.Column="2" Style="{StaticResource ModernCard}" Padding="18">
                                    <StackPanel>
                                        <TextBlock Text="💊 PHARMACY NEAR EXPIRY ALERTS (FEFO)" Foreground="{StaticResource DangerRedBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>
                                        <ItemsControl ItemsSource="{Binding ExpiringBatchesSummary}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#0F172A" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="{Binding MedicineName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding BatchNumber, StringFormat='Batch: {0}'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                                            </StackPanel>
                                                            <Border Grid.Column="1" Background="{Binding StatusBrush}" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ExpiryBadge}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ================================================================= -->
                <!-- TAB 2: POS QUICK BILLING TERMINAL & INVOICE HISTORY               -->
                <!-- ================================================================= -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentDashboardTab}" Value="Billing">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <!-- Top Sub-Navigation: New Sale vs Previous Invoices -->
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Sub-Navigation Header -->
                    <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Padding="12,8" Margin="0,0,0,14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton GroupName="PosBillingSubTabs" Content="🛒 New POS Sale Terminal" Style="{StaticResource ModernNavRadioButton}" IsChecked="True" Command="{Binding SetBillingSubTabCommand}" CommandParameter="NewSale"/>
                                <RadioButton GroupName="PosBillingSubTabs" Content="🧾 Previous Invoices &amp; History" Style="{StaticResource ModernNavRadioButton}" Margin="8,0,0,0" Command="{Binding SetBillingSubTabCommand}" CommandParameter="History"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Quick Bill Status: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding PosStatusMessage}" Foreground="{StaticResource SuccessGreenBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- SUB-VIEW 1: NEW POS SALE TERMINAL -->
                    <Grid Grid.Row="1">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BillingSubTab}" Value="NewSale">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <Grid.ColumnDefinitions>
                            <!-- Col 0: Left Vertical Categories Navigation Sidebar -->
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="14"/>
                            <!-- Col 2: Center Product Catalog & Quick Search -->
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <!-- Col 4: Right POS Cart & Settlement -->
                            <ColumnDefinition Width="460"/>
                        </Grid.ColumnDefinitions>

                        <!-- ========================================================= -->
                        <!-- COLUMN 0: VERTICAL CATEGORY NAVIGATION SIDEBAR            -->
                        <!-- ========================================================= -->
                        <Border Grid.Column="0" Style="{StaticResource ModernCard}" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                    <TextBlock Text="📁 CATEGORIES" Foreground="{StaticResource AccentCyanBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,2"/>
                                    <TextBlock Text="Select category to filter" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                </StackPanel>

                                <!-- Vertical Category ListBox -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ListBox ItemsSource="{Binding PosCategories}"
                                             SelectedItem="{Binding SelectedPosCategory, Mode=TwoWay}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Background" Value="#0F172A"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                <Setter Property="BorderBrush" Value="#1E293B"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="Padding" Value="12,10"/>
                                                <Setter Property="Margin" Value="0,0,0,6"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="CatBorder"
                                                                    Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="8"
                                                                    Padding="{TemplateBinding Padding}"
                                                                    Margin="{TemplateBinding Margin}">
                                                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="CatBorder" Property="Background" Value="#1E293B"/>
                                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                    <Setter TargetName="CatBorder" Property="BorderBrush" Value="{StaticResource AccentCyanBrush}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="CatBorder" Property="Background" Value="#1E3A8A"/>
                                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                    <Setter TargetName="CatBorder" Property="BorderBrush" Value="{StaticResource AccentCyanBrush}"/>
                                                                    <Setter TargetName="CatBorder" Property="BorderThickness" Value="1.5"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- ========================================================= -->
                        <!-- COLUMN 2: CENTER PRODUCT SEARCH & QUICK CATALOG GRID       -->
                        <!-- ========================================================= -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Search & Filter Bar -->
                            <Border Grid.Row="0" Style="{StaticResource ModernCard}" Padding="14" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding PosSearchQuery, UpdateSourceTrigger=PropertyChanged}" Tag="Scan barcode or type SKU/Product Name..." Style="{StaticResource ModernTextBox}" Height="42" FontSize="14" ToolTip="Scan barcode or type SKU/Product Name..."/>
                                    <Button Grid.Column="2" Content="🔍 Scan / Add" Style="{StaticResource PrimaryButton}" Height="42" Command="{Binding AddProductToCartCommand}" CommandParameter="{Binding PosSearchQuery}"/>
                                </Grid>
                            </Border>

                            <!-- Product Quick Catalog Grid -->
                            <Border Grid.Row="1" Style="{StaticResource ModernCard}" Padding="14">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding FilteredPosProducts}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="195" Background="#0F172A" CornerRadius="8" Padding="12" Margin="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                    <StackPanel>
                                                        <!-- Category Badge -->
                                                        <Border Background="#1E293B" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,0,6">
                                                            <TextBlock Text="{Binding CategoryName}" Foreground="{StaticResource AccentCyanBrush}" FontSize="10" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                        </Border>

                                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding SKU}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,6"/>
                                                        <Grid Margin="0,0,0,8">
                                                            <TextBlock Text="{Binding SellingPrice, StringFormat='₹{0:N2}'}" Foreground="{StaticResource SuccessGreenBrush}" FontSize="15" FontWeight="Bold"/>
                                                            <TextBlock Text="{Binding GSTRate, StringFormat='{}{0}% GST'}" Foreground="{StaticResource AccentCyanBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        </Grid>
                                                        <Button Content="🛒 Add to Cart" Style="{StaticResource PrimaryButton}" Height="32" FontSize="11" Padding="0" Command="{Binding DataContext.AddProductToCartCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Grid>

                        <!-- ========================================================= -->
                        <!-- COLUMN 4: RIGHT POS CART & SETTLEMENT PANEL               -->
                        <!-- ========================================================= -->
                        <Border Grid.Column="4" Style="{StaticResource ModernCard}" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Customer & Cart Header -->
                                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="CURRENT POS BILL" Foreground="{StaticResource AccentCyanBrush}" FontSize="14" FontWeight="Bold"/>
                                        <TextBlock Text="B2C / B2B Sale" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,2,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="6"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" Tag="Customer Name (e.g. Rahul Sharma)" Style="{StaticResource ModernTextBox}" Height="34" FontSize="11" ToolTip="Customer Name"/>
                                        <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding CustomerPhone, UpdateSourceTrigger=PropertyChanged}" Tag="Mobile / WhatsApp (e.g. 9876543210)" Style="{StaticResource ModernTextBox}" Height="34" FontSize="11" ToolTip="Mobile / WhatsApp"/>
                                        <TextBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Text="{Binding CustomerGstin, UpdateSourceTrigger=PropertyChanged}" Tag="Customer GSTIN (e.g. 27AAAAA0000A1Z5 - B2B Tax Invoice)" Style="{StaticResource ModernTextBox}" Height="32" FontSize="11" ToolTip="Customer GSTIN (Optional B2B Tax Invoice)"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Cart Items List -->
                                <Border Grid.Row="1" Background="#0F172A" CornerRadius="6" Padding="8" Margin="0,0,0,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding PosCartItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#1E293B" CornerRadius="6" Padding="10,8" Margin="0,0,0,6" BorderBrush="#334155" BorderThickness="1">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <!-- Row 0: Product Info & Line Total & Delete -->
                                                            <Grid Grid.Row="0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Left: Name & Unit Price -->
                                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding ProductName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProductName}"/>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                        <TextBlock Text="{Binding UnitPrice, StringFormat='₹{0:N2}'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                                                        <TextBlock Text=" • " Foreground="#475569" FontSize="10"/>
                                                                        <TextBlock Text="{Binding GSTRate, StringFormat='GST {0}%'}" Foreground="#64748B" FontSize="10"/>
                                                                    </StackPanel>
                                                                </StackPanel>

                                                                <!-- Center/Right: Line Total -->
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,4,0">
                                                                    <TextBlock Text="{Binding TotalAmount, StringFormat='₹{0:N2}'}" Foreground="{StaticResource SuccessGreenBrush}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                                    <TextBlock Text="{Binding DiscountAmount, StringFormat='-₹{0:N2} disc'}" Foreground="{StaticResource WarningAmberBrush}" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Right">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding HasDiscount}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </StackPanel>

                                                                <!-- Delete Action -->
                                                                <Button Grid.Column="2" Content="❌" Background="Transparent" Foreground="{StaticResource DangerRedBrush}" BorderThickness="0" Margin="6,0,0,0" VerticalAlignment="Center" Padding="4,2" Cursor="Hand" ToolTip="Remove item from bill" Command="{Binding DataContext.RemoveCartItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                            </Grid>

                                                            <!-- Row 1: Quantity Stepper & Line Item Discount Input -->
                                                            <Border Grid.Row="1" Margin="0,6,0,0" Padding="0,6,0,0" BorderBrush="#334155" BorderThickness="0,1,0,0">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- Left: Qty Stepper [-] [ 1 ] [+] -->
                                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <TextBlock Text="Qty:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>

                                                                        <Button Content="−" Width="24" Height="24" Background="#334155" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="12" Cursor="Hand" ToolTip="Decrease quantity" Command="{Binding DataContext.DecreaseCartItemQuantityCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                                            <Button.Resources>
                                                                                <Style TargetType="Border">
                                                                                    <Setter Property="CornerRadius" Value="3,0,0,3"/>
                                                                                </Style>
                                                                            </Button.Resources>
                                                                        </Button>

                                                                        <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.##}'}" Width="36" Height="24" Background="#0F172A" Foreground="{StaticResource AccentCyanBrush}" BorderBrush="#334155" BorderThickness="1,1,1,1" TextAlignment="Center" VerticalContentAlignment="Center" FontSize="11" FontWeight="Bold" ToolTip="Item Quantity"/>

                                                                        <Button Content="+" Width="24" Height="24" Background="#334155" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="12" Cursor="Hand" ToolTip="Increase quantity" Command="{Binding DataContext.IncreaseCartItemQuantityCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                                            <Button.Resources>
                                                                                <Style TargetType="Border">
                                                                                    <Setter Property="CornerRadius" Value="0,3,3,0"/>
                                                                                </Style>
                                                                            </Button.Resources>
                                                                        </Button>
                                                                    </StackPanel>

                                                                    <!-- Right: Item-Level Discount Input (Admin) -->
                                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <TextBlock Text="🏷️ Item Disc ₹:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                                        <TextBox Text="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.##}'}" Width="56" Height="24" Background="#0F172A" Foreground="{StaticResource WarningAmberBrush}" BorderBrush="#334155" BorderThickness="1" TextAlignment="Right" VerticalContentAlignment="Center" FontSize="11" FontWeight="SemiBold" IsEnabled="{Binding DataContext.CanApplyDiscount, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="Line-item discount in ₹ (Admin Right Required)"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>

                                <!-- Bill Calculation & Settle -->
                                <StackPanel Grid.Row="2">
                                    <!-- Discount Controls (Role Restricted to Business Admin) -->
                                    <Border Background="#0F172A" CornerRadius="6" Padding="10,6" Margin="0,0,0,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="🏷️ BILL DISCOUNT (ADMIN RIGHT)" Foreground="{StaticResource AccentCyanBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding DiscountPermissionStatusText}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Mode Toggle -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <Button Content="₹ Flat" Style="{StaticResource PrimaryButton}" Height="30" Padding="8,0" FontSize="11" FontWeight="Bold" IsEnabled="{Binding CanApplyDiscount}" Command="{Binding SetDiscountTypeCommand}" CommandParameter="Flat"/>
                                                    <Button Content="% Pct" Style="{StaticResource PrimaryButton}" Height="30" Padding="8,0" FontSize="11" FontWeight="Bold" Margin="4,0,0,0" IsEnabled="{Binding CanApplyDiscount}" Command="{Binding SetDiscountTypeCommand}" CommandParameter="Percentage"/>
                                                </StackPanel>

                                                <!-- Discount Input Box -->
                                                <TextBox Grid.Column="2" Text="{Binding DiscountValue, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.##}'}" Tag="Discount amount..." Style="{StaticResource ModernTextBox}" Height="30" FontSize="11" IsEnabled="{Binding CanApplyDiscount}" ToolTip="Discount value (Only Business Admin or Authorized Staff)"/>

                                                <!-- Amount Display -->
                                                <Border Grid.Column="3" Background="#1E293B" CornerRadius="4" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding PosDiscountTotal, StringFormat='-₹{0:N2}'}" Foreground="{StaticResource WarningAmberBrush}" FontSize="11" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Summary Calculation Rows -->
                                    <Grid Margin="0,0,0,3">
                                        <TextBlock Text="Gross Subtotal:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                        <TextBlock Text="{Binding PosGrossTotal, StringFormat='₹{0:N2}'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,3">
                                        <TextBlock Text="Taxable Value (Post-Discount):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                        <TextBlock Text="{Binding PosSubTotal, StringFormat='₹{0:N2}'}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="GST Tax Total (CGST + SGST):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                        <TextBlock Text="{Binding PosTaxTotal, StringFormat='₹{0:N2}'}" Foreground="{StaticResource AccentCyanBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Border Background="#111827" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                                        <Grid>
                                            <TextBlock Text="GRAND TOTAL:" Foreground="White" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding PosGrandTotal, StringFormat='₹{0:N2}'}" Foreground="{StaticResource SuccessGreenBrush}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Payment Mode:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding SelectedPaymentMethod}" Style="{StaticResource ModernComboBox}" Height="34"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Target Printer:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding AvailablePrinters}" SelectedItem="{Binding SelectedPrinter}" Style="{StaticResource ModernComboBox}" Height="34" FontSize="11" ToolTip="Select printer for direct printing"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="2*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="🧹 Clear" Style="{StaticResource PrimaryButton}" Background="{StaticResource SurfaceCardBrush}" Height="40" Command="{Binding ClearCartCommand}"/>
                                        <Button Grid.Column="2" Content="💳 Settle &amp; Direct Print" Style="{StaticResource SuccessButton}" Height="40" FontSize="13" FontWeight="Bold" Command="{Binding CheckoutAndPrintInvoiceCommand}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- SUB-VIEW 2: PREVIOUS INVOICES & BILLING HISTORY -->
                    <Grid Grid.Row="1">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BillingSubTab}" Value="History">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <Border Style="{StaticResource ModernCard}" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Header & Search -->
                                <Grid Grid.Row="0" Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="320"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="🧾 Previous Invoices &amp; Historical Billing Archive" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold"/>
                                        <TextBlock Text="Search, inspect, and reprint any historical customer tax invoice with GST breakdown" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                    </StackPanel>

                                    <TextBox Grid.Column="1" Text="{Binding InvoiceSearchQuery, UpdateSourceTrigger=PropertyChanged}" Tag="🔍 Search by Invoice #, Customer, Mobile..." Style="{StaticResource ModernTextBox}" Height="40" FontSize="13" ToolTip="Search by Invoice #, Customer, Mobile..."/>
                                </Grid>

                                <!-- Invoices DataGrid -->
                                <DataGrid Grid.Row="1"
                                          ItemsSource="{Binding FilteredInvoices}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          IsReadOnly="True"
                                          Background="#0F172A"
                                          RowBackground="#1E293B"
                                          AlternatingRowBackground="#182234"
                                          Foreground="{StaticResource TextPrimaryBrush}"
                                          BorderBrush="{StaticResource BorderBrush}"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#334155"
                                          RowHeight="44">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="INVOICE NO" Binding="{Binding InvoiceNumber}" Width="120"/>
                                        <DataGridTextColumn Header="DATE &amp; TIME" Binding="{Binding InvoiceDateUtc, StringFormat='{}{0:dd-MMM-yyyy HH:mm}'}" Width="140"/>
                                        <DataGridTextColumn Header="CUSTOMER" Binding="{Binding CustomerName}" Width="1.4*"/>
                                        <DataGridTextColumn Header="GSTIN (B2B)" Binding="{Binding CustomerGSTIN, TargetNullValue='-'}" Width="130"/>
                                        <DataGridTextColumn Header="CONTACT" Binding="{Binding CustomerPhone}" Width="110"/>
                                        <DataGridTextColumn Header="PAYMENT" Binding="{Binding PaymentMethod}" Width="85"/>
                                        <DataGridTextColumn Header="DISCOUNT (₹)" Binding="{Binding TotalDiscount, StringFormat='₹{0:N2}'}" Width="100"/>
                                        <DataGridTextColumn Header="TAXABLE (₹)" Binding="{Binding TaxableAmount, StringFormat='₹{0:N2}'}" Width="105"/>
                                        <DataGridTextColumn Header="GST TAX (₹)" Binding="{Binding TotalTax, StringFormat='₹{0:N2}'}" Width="105"/>
                                        <DataGridTextColumn Header="GRAND TOTAL (₹)" Binding="{Binding GrandTotal, StringFormat='₹{0:N2}'}" Width="125"/>
                                        <DataGridTextColumn Header="CASHIER" Binding="{Binding CashierUsername}" Width="90"/>
                                        <DataGridTemplateColumn Header="ACTIONS" Width="130">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="🖨️ Print Preview" Style="{StaticResource PrimaryButton}" Padding="8,4" FontSize="11" FontWeight="Bold" Command="{Binding DataContext.OpenPrintPreviewCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ================================================================= -->
                <!-- TAB 3: INVENTORY & PRODUCT CATALOG                                -->
                <!-- ================================================================= -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentDashboardTab}" Value="Inventory">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="460" MinWidth="420" MaxWidth="520"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Inventory Table -->
                    <Border Grid.Column="0" Style="{StaticResource ModernCard}" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Store Inventory &amp; Stock Catalog" Foreground="{StaticResource TextPrimaryBrush}" FontSize="20" FontWeight="Bold"/>
                                    <TextBlock Text="Full multi-tax product inventory with stock in/out controls" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="📁 Categories &amp; Cafe Templates" Style="{StaticResource PrimaryButton}" Background="#1E293B" Foreground="{StaticResource AccentCyanBrush}" Height="40" Padding="14,0" FontSize="12" FontWeight="Bold" Margin="0,0,12,0" Command="{Binding OpenManageCategoriesModalCommand}"/>
                                <ComboBox Grid.Column="2" ItemsSource="{Binding PosCategories}" SelectedItem="{Binding SelectedInventoryCategory}" Style="{StaticResource ModernComboBox}" Height="40" FontSize="12" Margin="0,0,12,0" ToolTip="Filter inventory by category"/>
                                <TextBox Grid.Column="3" Text="{Binding InventorySearchQuery, UpdateSourceTrigger=PropertyChanged}" Tag="🔍 Search product name, SKU, HSN..." Style="{StaticResource ModernTextBox}" Height="40" FontSize="13" ToolTip="Search products..."/>
                            </Grid>

                            <!-- Product Table -->
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding FilteredInventoryProducts}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      Background="#0F172A"
                                      RowBackground="#1E293B"
                                      AlternatingRowBackground="#182234"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      BorderBrush="{StaticResource BorderBrush}"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#334155"
                                      RowHeight="40">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="ITEM CODE / SKU" Binding="{Binding SKU}" Width="110"/>
                                    <DataGridTextColumn Header="BARCODE" Binding="{Binding Barcode}" Width="100"/>
                                    <DataGridTextColumn Header="HSN" Binding="{Binding HSNCode}" Width="75"/>
                                    <DataGridTextColumn Header="BUY RATE" Binding="{Binding PurchasePrice, StringFormat='₹{0:N2}'}" Width="85"/>
                                    <DataGridTextColumn Header="SELL RATE" Binding="{Binding SellingPrice, StringFormat='₹{0:N2}'}" Width="85"/>
                                    <DataGridTextColumn Header="GST" Binding="{Binding GSTRate, StringFormat='{}{0}%'}" Width="55"/>
                                    <DataGridTextColumn Header="STOCK" Binding="{Binding CurrentStock}" Width="65"/>
                                    <DataGridTemplateColumn Header="STOCK CONTROLS" Width="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Content="📦 Adjust Stock" Style="{StaticResource PrimaryButton}" Background="#2563EB" Foreground="White" Height="28" Padding="10,0" FontSize="11" FontWeight="Bold" Command="{Binding DataContext.OpenStockControlModalCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Open Full Stock Control &amp; Adjustment Modal (Inward/Outward/Audit)"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Right: Add Product Form -->
                    <Border Grid.Column="2" Style="{StaticResource ModernCard}" Padding="20">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="➕ ADD NEW PRODUCT / MEDICINE" Foreground="{StaticResource AccentCyanBrush}" FontSize="15" FontWeight="Bold" Margin="0,0,0,14"/>

                                <!-- Category Dropdown -->
                                <Grid Margin="0,0,0,3">
                                    <TextBlock Text="Product Category *" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Button Content="⚙️ Manage / Switch Preset" Background="Transparent" Foreground="{StaticResource AccentCyanBrush}" BorderThickness="0" Padding="4,0" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" Cursor="Hand" Command="{Binding OpenManageCategoriesModalCommand}"/>
                                </Grid>
                                <ComboBox ItemsSource="{Binding AvailableCategories}" SelectedItem="{Binding SelectedCategory}" Style="{StaticResource ModernComboBox}" Height="38" FontSize="12" Margin="0,0,0,10" ToolTip="{Binding SelectedCategory}"/>

                                <!-- Product Name -->
                                <TextBlock Text="Product / Medicine Name *" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding NewProductName, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. Paracetamol 650mg Tablets" Style="{StaticResource ModernTextBox}" Height="36" FontSize="12" Margin="0,0,0,10"/>

                                <!-- Item Code / SKU & Barcode Inputs -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Item Code / SKU *" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding NewProductSku, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. ITM-1001" Style="{StaticResource ModernTextBox}" Height="36" FontSize="12" ToolTip="Item Code / SKU (Auto-generated if left blank)"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Barcode / EAN" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding NewProductBarcode, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. 8901234567890" Style="{StaticResource ModernTextBox}" Height="36" FontSize="12" ToolTip="Barcode / EAN (Auto-generated if left blank)"/>
                                    </StackPanel>
                                </Grid>

                                <!-- HSN & Unit Dropdowns -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="HSN Code *" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                        <ComboBox ItemsSource="{Binding AvailableHsnCodes}" SelectedItem="{Binding SelectedHsn}" Style="{StaticResource ModernComboBox}" Height="38" FontSize="12" ToolTip="{Binding SelectedHsn}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Unit (UQC) *" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                        <ComboBox ItemsSource="{Binding AvailableUnits}" SelectedItem="{Binding SelectedUnit}" Style="{StaticResource ModernComboBox}" Height="38" FontSize="12" ToolTip="{Binding SelectedUnit}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Buy Price, Selling Price, MRP -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Buy Rate (₹)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding NewPurchasePrice, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. 100" Style="{StaticResource ModernTextBox}" Height="36" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Sell Rate (₹)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding NewSellingPrice, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. 150" Style="{StaticResource ModernTextBox}" Height="36" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="MRP (₹)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding NewMrp, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. 150" Style="{StaticResource ModernTextBox}" Height="36" FontSize="12"/>
                                    </StackPanel>
                                </Grid>

                                <!-- GST Rate Slab Dropdown -->
                                <TextBlock Text="GST Tax Bracket *" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                <ComboBox ItemsSource="{Binding AvailableGstSlabs}" SelectedItem="{Binding SelectedGstSlab}" Style="{StaticResource ModernComboBox}" Height="38" FontSize="12" Margin="0,0,0,10" ToolTip="{Binding SelectedGstSlab}"/>

                                <!-- Opening Stock & Min Alert -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Opening Stock (Qty)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding NewCurrentStock, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. 50" Style="{StaticResource ModernTextBox}" Height="36" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Min Alert Level" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding NewMinStock, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. 10" Style="{StaticResource ModernTextBox}" Height="36" FontSize="12"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Batch Number & Expiry Date (Pharmacy / FEFO) -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Batch Number" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding NewBatchNumber, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. BAT-2605" Style="{StaticResource ModernTextBox}" Height="36" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Expiry Date" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                        <DatePicker SelectedDate="{Binding NewExpiryDate}" Style="{StaticResource ModernDatePicker}" Height="36" FontSize="12"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Rack Location Dropdown & Create Custom Rack Button -->
                                <TextBlock Text="Rack / Storage Location *" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableRackLocations}" SelectedItem="{Binding SelectedRackLocation}" Style="{StaticResource ModernComboBox}" Height="38" FontSize="12" ToolTip="{Binding SelectedRackLocation}"/>
                                    <Button Grid.Column="2" Content="➕ New Rack" Style="{StaticResource PrimaryButton}" Height="38" Padding="12,0" FontSize="11" FontWeight="Bold" Command="{Binding OpenCreateRackModalCommand}"/>
                                </Grid>

                                <TextBlock Text="{Binding InventoryFormMessage}" Foreground="{StaticResource SuccessGreenBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,12" TextWrapping="Wrap"/>

                                <Button Content="💾 Save Product to Inventory" Style="{StaticResource SuccessButton}" Height="42" FontSize="13" FontWeight="Bold" Command="{Binding SaveNewProductCommand}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ================================================================= -->
                <!-- TAB 4: PHARMACY BATCH & EXPIRY TRACKER                            -->
                <!-- ================================================================= -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentDashboardTab}" Value="Pharmacy">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Border Style="{StaticResource ModernCard}" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="260"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="💊 Pharmacy Batch &amp; Expiry Management" Foreground="{StaticResource TextPrimaryBrush}" FontSize="20" FontWeight="Bold"/>
                                    <TextBlock Text="First-Expiry First-Out (FEFO) audit trail with real-time quarantine and expiration countdown" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                </StackPanel>

                                <!-- Filter Buttons -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton GroupName="PharmacyStatusFilters" Content="All Batches" Style="{StaticResource ModernFilterRadioButton}" IsChecked="True" Command="{Binding SetPharmacyFilterModeCommand}" CommandParameter="All"/>
                                    <RadioButton GroupName="PharmacyStatusFilters" Content="🔴 Expired" Style="{StaticResource ModernFilterRadioButton}" Command="{Binding SetPharmacyFilterModeCommand}" CommandParameter="Expired"/>
                                    <RadioButton GroupName="PharmacyStatusFilters" Content="🟠 Near Expiry (&lt;60d)" Style="{StaticResource ModernFilterRadioButton}" Command="{Binding SetPharmacyFilterModeCommand}" CommandParameter="NearExpiry"/>
                                    <RadioButton GroupName="PharmacyStatusFilters" Content="🟢 Safe Stock" Style="{StaticResource ModernFilterRadioButton}" Command="{Binding SetPharmacyFilterModeCommand}" CommandParameter="Safe"/>
                                </StackPanel>

                                <TextBox Grid.Column="3" Text="{Binding PharmacySearchQuery, UpdateSourceTrigger=PropertyChanged}" Tag="🔍 Search medicine, batch #, or rack..." Style="{StaticResource ModernTextBox}" Height="40" FontSize="13" ToolTip="Search medicine or batch..."/>
                            </Grid>

                            <!-- Pharmacy Batches DataGrid -->
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding FilteredPharmacyBatches}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      Background="#0F172A"
                                      RowBackground="#1E293B"
                                      AlternatingRowBackground="#182234"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      BorderBrush="{StaticResource BorderBrush}"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#334155"
                                      RowHeight="42">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="MEDICINE / DRUG NAME" Binding="{Binding MedicineName}" Width="2*"/>
                                    <DataGridTextColumn Header="BATCH NUMBER" Binding="{Binding BatchNumber}" Width="130"/>
                                    <DataGridTextColumn Header="EXPIRY DATE" Binding="{Binding ExpiryDate, StringFormat='{}{0:MMM yyyy}'}" Width="110"/>
                                    <DataGridTextColumn Header="DAYS LEFT" Binding="{Binding DaysToExpiry, StringFormat='{}{0} Days'}" Width="100"/>
                                    <DataGridTemplateColumn Header="STATUS" Width="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding StatusBrush}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Status}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="STOCK (UNITS)" Binding="{Binding Stock}" Width="100"/>
                                    <DataGridTextColumn Header="MRP (₹)" Binding="{Binding MRP, StringFormat='₹{0:N2}'}" Width="90"/>
                                    <DataGridTextColumn Header="RACK / SHELF" Binding="{Binding RackLocation}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ================================================================= -->
                <!-- TAB 5: GST STATUTORY RETURNS & FINANCIAL REPORTS                  -->
                <!-- ================================================================= -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentDashboardTab}" Value="Reports">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Border Style="{StaticResource ModernCard}" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Report Header & Toolbar -->
                            <Grid Grid.Row="0" Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="📊 GST Statutory Returns &amp; Tax Engine" Foreground="{StaticResource TextPrimaryBrush}" FontSize="20" FontWeight="Bold"/>
                                        <Border Background="#1E1B4B" CornerRadius="4" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="👑 SUPER ADMIN &amp; CA ONLY" Foreground="{StaticResource AccentCyanBrush}" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Statutory HSN and Rate-wise Outward &amp; Inward Supplies Returns (GSTR-1, GSTR-2, GSTR-3B)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Month Selector -->
                                    <TextBlock Text="Period:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox ItemsSource="{Binding AvailableExportMonths}" SelectedItem="{Binding SelectedGstReportMonth}" Style="{StaticResource ModernComboBox}" Width="190" Height="38" Margin="0,0,8,0"/>
                                    
                                    <!-- Year Selector -->
                                    <ComboBox ItemsSource="{Binding AvailableExportYears}" SelectedItem="{Binding SelectedGstReportYear}" Style="{StaticResource ModernComboBox}" Width="90" Height="38" Margin="0,0,10,0"/>

                                    <Button Content="🔄 Refresh" Style="{StaticResource PrimaryButton}" Height="38" FontSize="12" Margin="0,0,8,0" Command="{Binding GenerateGstReportCommand}"/>
                                    <Button Content="📥 Export CSV" Style="{StaticResource SuccessButton}" Height="38" FontSize="12" Command="{Binding ExportGstReportCsvCommand}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Tax Summary KPI Cards -->
                            <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,18">
                                <Border Background="#0F172A" CornerRadius="6" Padding="12" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="TAXABLE TURNOVER" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding ReportTotalTaxableValue, StringFormat='₹{0:N2}'}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#0F172A" CornerRadius="6" Padding="12" Margin="3,0,3,0">
                                    <StackPanel>
                                        <TextBlock Text="TOTAL CGST (CENTRAL)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding ReportTotalCgst, StringFormat='₹{0:N2}'}" Foreground="{StaticResource AccentCyanBrush}" FontSize="16" FontWeight="Bold" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#0F172A" CornerRadius="6" Padding="12" Margin="3,0,3,0">
                                    <StackPanel>
                                        <TextBlock Text="TOTAL SGST (STATE)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding ReportTotalSgst, StringFormat='₹{0:N2}'}" Foreground="{StaticResource AccentCyanBrush}" FontSize="16" FontWeight="Bold" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#0F172A" CornerRadius="6" Padding="12" Margin="3,0,3,0">
                                    <StackPanel>
                                        <TextBlock Text="TOTAL GST TAX LIABILITY" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding ReportTotalTax, StringFormat='₹{0:N2}'}" Foreground="{StaticResource WarningAmberBrush}" FontSize="16" FontWeight="Bold" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#0F172A" CornerRadius="6" Padding="12" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="GROSS AGGREGATE SALES" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding ReportGrandTotalSales, StringFormat='₹{0:N2}'}" Foreground="{StaticResource SuccessGreenBrush}" FontSize="16" FontWeight="Bold" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- HSN Wise DataGrid -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Col 1: HSN Summary -->
                                <Border Grid.Column="0" Background="#0F172A" CornerRadius="6" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="GSTR-1: HSN WISE SUMMARY OF OUTWARD SUPPLIES" Foreground="{StaticResource AccentCyanBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>
                                        <DataGrid ItemsSource="{Binding GstHsnSummaries}"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  IsReadOnly="True"
                                                  Background="Transparent"
                                                  RowBackground="#1E293B"
                                                  AlternatingRowBackground="#182234"
                                                  Foreground="{StaticResource TextPrimaryBrush}"
                                                  BorderThickness="0"
                                                  RowHeight="36">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="HSN CODE" Binding="{Binding HSNCode}" Width="90"/>
                                                <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*"/>
                                                <DataGridTextColumn Header="QTY" Binding="{Binding TotalQuantity}" Width="60"/>
                                                <DataGridTextColumn Header="TAXABLE (₹)" Binding="{Binding TaxableValue, StringFormat='₹{0:N2}'}" Width="110"/>
                                                <DataGridTextColumn Header="RATE" Binding="{Binding GstRate, StringFormat='{}{0}%'}" Width="60"/>
                                                <DataGridTextColumn Header="CGST (₹)" Binding="{Binding CentralTaxAmount, StringFormat='₹{0:N2}'}" Width="90"/>
                                                <DataGridTextColumn Header="SGST (₹)" Binding="{Binding StateTaxAmount, StringFormat='₹{0:N2}'}" Width="90"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>

                                <!-- Col 2: Rate Wise Breakdown -->
                                <Border Grid.Column="2" Background="#0F172A" CornerRadius="6" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="TAX RATE SLAB BREAKDOWN" Foreground="{StaticResource AccentCyanBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>
                                        <DataGrid ItemsSource="{Binding GstRateBreakdowns}"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  IsReadOnly="True"
                                                  Background="Transparent"
                                                  RowBackground="#1E293B"
                                                  AlternatingRowBackground="#182234"
                                                  Foreground="{StaticResource TextPrimaryBrush}"
                                                  BorderThickness="0"
                                                  RowHeight="36">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="SLAB" Binding="{Binding RateLabel}" Width="*"/>
                                                <DataGridTextColumn Header="TAXABLE" Binding="{Binding TaxableAmount, StringFormat='₹{0:N2}'}" Width="100"/>
                                                <DataGridTextColumn Header="TAX (₹)" Binding="{Binding TotalTaxAmount, StringFormat='₹{0:N2}'}" Width="90"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ================================================================= -->
                <!-- TAB 6: USERS, ROLES & GRANULAR PERMISSIONS                        -->
                <!-- ================================================================= -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentDashboardTab}" Value="Users">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="380"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Users List -->
                    <Border Grid.Column="0" Style="{StaticResource ModernCard}" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                                <TextBlock Text="👥 Store Staff &amp; Operator Roles" Foreground="{StaticResource TextPrimaryBrush}" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="Manage user accounts, assigned operational roles, and granular system permissions" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                            </StackPanel>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding AllStoreUsers}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      Background="#0F172A"
                                      RowBackground="#1E293B"
                                      AlternatingRowBackground="#182234"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      BorderBrush="{StaticResource BorderBrush}"
                                      RowHeight="42">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="FULL NAME" Binding="{Binding FullName}" Width="*"/>
                                    <DataGridTextColumn Header="USERNAME" Binding="{Binding Username}" Width="120"/>
                                    <DataGridTextColumn Header="ROLE" Binding="{Binding Role}" Width="130"/>
                                    <DataGridTemplateColumn Header="STATUS" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#064E3B" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="ACTIVE" Foreground="#6EE7B7" FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="CONTROLS" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
